{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "scripts/**/*.ts", "tests/**/*.ts", "*.config.ts", "art/**/*.json"],
  "exclude": ["dist", "node_modules", "public/game"]
}
