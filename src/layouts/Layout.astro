---
import '../styles/global.css';
import LangSwitch from '../components/ui/LangSwitch.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cristian Zapata Cartagena — Full Stack Developer',
  description = 'Full Stack Developer & Chemical Engineer. Building precision interfaces fused with scientific thinking.',
} = Astro.props;

/* Companion poses — order is meaningful (scenes address them by
   data-companion-pose, not by index, but keep it stable for readability).

   Both rigs share ONE srcset so the browser downloads a single file per pose no
   matter which rig is visible. `base` differs from `pose` for hero: the
   companions need the proportional `panda-hero-pose-*` ladder, not the
   square-cropped `panda-hero-*` LCP ladder. Canonical PNGs (~1 MB each) are no
   longer requested by any rig — see scripts/generate-panda-derivatives.mjs.
   `sizes` mirrors the CSS: desktop rig ≤16rem, mobile rig ≤8rem. */
const COMPANION_POSES = [
  { pose: 'hero', base: 'panda-hero-pose', ratio: [4, 5] },
  { pose: 'master', base: 'panda-master', ratio: [1, 1] },
  { pose: 'coding', base: 'panda-coding', ratio: [4, 5] },
  { pose: 'wave', base: 'panda-wave', ratio: [4, 5] },
  { pose: 'head', base: 'panda-head', ratio: [1, 1] },
] as const;

const COMPANION_SIZES = '(min-width: 1024px) 16rem, 8rem';
const srcsetFor = (base: string) =>
  `/media/panda/generated/${base}-320.webp 320w, /media/panda/generated/${base}-480.webp 480w`;
---

<!doctype html>
<html lang="es-419">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      as="image"
      href="/media/panda/generated/panda-hero-320.webp"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/media/panda/generated/panda-hero-800.webp"
      media="(min-width: 768px)"
      fetchpriority="high"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Preconnect for performance (fonts once self-hosted) -->
    <!-- <link rel="preconnect" href="/fonts" crossorigin /> -->

    <title>{title}</title>

    <!-- Marks that scripting is available, before first paint. Anything that is
         hidden in CSS *because* JS will animate it in must be gated on this, so
         a blocked or failed script can never leave content permanently
         invisible (see `html.js .hero-char` in global.css). Inline and first in
         <head> so it applies to the very first painted frame. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Canonical scroll-position hint for ScrollTrigger -->
    <style>
      /* Prevent lower-section FOUC before GSAP initialises; keep hero paintable for LCP.
         The fixed backdrop stage is excluded — it must paint immediately (its base
         gradient + faded-in layers) instead of popping in when the deferred
         controller mounts ~1s later. */
      [data-scene]:not(#hero):not(#scroll-stage) {
        opacity: 0;
      }
    </style>
  </head>
  <body>
    <!-- Fixed parallax stage — layers driven by global scroll progress.
         MUST stay a sibling OUTSIDE #smooth-wrapper so ScrollSmoother's
         transform never moves it; it remains truly fixed behind content. -->
    <div id="scroll-stage" aria-hidden="true" data-scene="backdrop">
      <!-- Each layer = OUTER (#stage-*: backdrop parallax x/y) + INNER (.stage-depth:
           hero pinned depth scale/translate). Independent transform channels so the
           two drivers never fight and there is no jump when the hero pin releases. -->
      <div class="stage-layer" id="stage-atmosphere">
        <div class="stage-depth"><!-- atmosphere.webp set by backdrop scene --></div>
      </div>
      <div class="stage-layer" id="stage-mid-glass">
        <div class="stage-depth"><!-- mid-glass.webp --></div>
      </div>
      <div class="stage-layer" id="stage-particles">
        <div class="stage-depth"><!-- particles.webp --></div>
      </div>
    </div>

    <!-- Fixed panda companion — sibling outside #smooth-wrapper so ScrollSmoother
         never transforms it. Hidden on mobile by CSS; scene drives desktop poses. -->
    <div id="panda-companion" data-scene="companion" aria-hidden="true">
      <div class="panda-companion-stage" data-companion-stage>
        <div class="panda-companion-look" data-companion-look>
          {
            COMPANION_POSES.map(({ pose, base, ratio }) => (
              <img
                src={`/media/panda/generated/${base}-320.webp`}
                srcset={srcsetFor(base)}
                sizes={COMPANION_SIZES}
                alt=""
                width={320}
                height={(320 / ratio[0]) * ratio[1]}
                loading="lazy"
                decoding="async"
                data-companion-pose={pose}
              />
            ))
          }
        </div>
      </div>
    </div>

    <!-- Mobile panda companion — sibling outside #smooth-wrapper, like the desktop
         one. Shown < 1024px (where the desktop companion is hidden), so the panda
         is present on phones too. Same pose images (cached, lazy → no LCP cost);
         companionMobile.ts drives pose-per-section + tap/tilt reactions. -->
    <div id="panda-companion-mobile" data-scene="companion-mobile" aria-hidden="true">
      <div class="panda-companion-stage" data-companion-stage data-companion-tap>
        <div class="panda-companion-look" data-companion-look>
          {
            COMPANION_POSES.map(({ pose, base, ratio }) => (
              <img
                src={`/media/panda/generated/${base}-320.webp`}
                srcset={srcsetFor(base)}
                sizes={COMPANION_SIZES}
                alt=""
                width={160}
                height={(160 / ratio[0]) * ratio[1]}
                loading="lazy"
                decoding="async"
                data-companion-pose={pose}
              />
            ))
          }
        </div>
      </div>
    </div>

    <!-- ScrollSmoother DOM contract: #smooth-wrapper > #smooth-content.
         ScrollSmoother (controller.ts) applies the fixed/overflow styles to
         the wrapper and transforms the content. -->
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <!-- Page content scrolls above the fixed stage -->
        <main id="scroll-content">
          <slot />
        </main>
      </div>
    </div>

    <!-- Language switch UI — fixed pill outside smooth-wrapper -->
    <LangSwitch />

    <!-- i18n init — restores user's last language choice on page load -->
    <script>
      import '../scripts/i18n';
    </script>

    <!-- Liquid-glass magnifier loupe — desktop/fine-pointer only; bails otherwise -->
    <script>
      import { initGlassLoupe } from '../scripts/glass-loupe';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGlassLoupe);
      } else {
        initGlassLoupe();
      }
    </script>

    <!-- Off-screen effect gating — drops backdrop-filter + parks the sheen on
         glass surfaces that are ~a screen away. Not deferred with the
         controller: it only toggles a class, and running it early means
         off-screen surfaces never pay for the blur even once. -->
    <script>
      import { initOffscreenGating } from '../scripts/offscreen';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initOffscreenGating);
      } else {
        initOffscreenGating();
      }
    </script>

    <!-- Hero copy entrance. Deliberately NOT part of the deferred controller:
         this is the site's first impression and must play on arrival, not after
         ~51 KB gzip of GSAP has downloaded and mounted. ~1 KB, no dependencies. -->
    <script>
      import { initHeroEntrance } from '../scripts/heroEntrance';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeroEntrance);
      } else {
        initHeroEntrance();
      }
    </script>

    <!-- GSAP ScrollTrigger controller — mounted as soon as the LCP panda has
         painted, and not before.

         This used to wait for `requestIdleCallback(…, { timeout: 1200 })`. On a
         throttled phone the main thread is busy through that whole window, so it
         always hit the timeout and mounted at ~1.27s — a second AFTER the hero
         name had been painted and read. The scene then set the name to
         opacity 0 and re-animated it, which read as the title blinking out.

         Gating on the LCP image's decode keeps the original intent (never put
         GSAP's ~180ms mount in front of the largest paint) but expresses it
         precisely instead of guessing with a timeout, so the hero entrance now
         plays on arrival. The double rAF guarantees a frame has actually been
         presented before the mount task starts. -->
    <script>
      const mountScrollController = () => import('../scripts/scroll/controller.ts');

      const lcpImage = document.getElementById('panda-body') as HTMLImageElement | null;
      const lcpPainted = lcpImage?.decode
        ? lcpImage.decode().catch(() => undefined)
        : Promise.resolve();

      // Safety net: mount anyway if decode() never settles (image failed, or a
      // browser that resolves it oddly). Everything below the fold is
      // opacity:0 until the controller runs, so this must never be skipped.
      const fallback = new Promise((resolve) => globalThis.setTimeout(resolve, 1200));

      void Promise.race([lcpPainted, fallback]).then(() =>
        requestAnimationFrame(() => requestAnimationFrame(mountScrollController))
      );
    </script>
  </body>
</html>
