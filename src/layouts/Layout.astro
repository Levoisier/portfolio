---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cristian Zapata Cartagena — Full Stack Developer',
  description = 'Full Stack Developer & Chemical Engineer. Building precision interfaces fused with scientific thinking.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Preconnect for performance (fonts once self-hosted) -->
    <!-- <link rel="preconnect" href="/fonts" crossorigin /> -->

    <title>{title}</title>

    <!-- Canonical scroll-position hint for ScrollTrigger -->
    <style>
      /* Prevent FOUC before GSAP initialises */
      [data-scene] {
        opacity: 0;
      }
    </style>
  </head>
  <body>
    <!-- Fixed parallax stage — layers driven by global scroll progress -->
    <div id="scroll-stage" aria-hidden="true" data-scene="backdrop">
      <div class="stage-layer" id="stage-atmosphere">
        <!-- atmosphere.webp loaded by controller when media is ready -->
      </div>
      <div class="stage-layer" id="stage-mid-glass">
        <!-- mid-glass.webp -->
      </div>
      <div class="stage-layer" id="stage-particles">
        <!-- particles.webp -->
      </div>
    </div>

    <!-- Page content scrolls above the fixed stage -->
    <main id="scroll-content">
      <slot />
    </main>

    <!-- GSAP ScrollTrigger controller — loaded as module for tree-shaking -->
    <script>
      import '../scripts/scroll/controller.ts';
    </script>
  </body>
</html>
