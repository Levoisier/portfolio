---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cristian Zapata Cartagena — Full Stack Developer',
  description = 'Full Stack Developer & Chemical Engineer. Building precision interfaces fused with scientific thinking.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      as="image"
      href="/media/panda/generated/panda-hero-320.webp"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/media/panda/generated/panda-hero-800.webp"
      media="(min-width: 768px)"
      fetchpriority="high"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Preconnect for performance (fonts once self-hosted) -->
    <!-- <link rel="preconnect" href="/fonts" crossorigin /> -->

    <title>{title}</title>

    <!-- Canonical scroll-position hint for ScrollTrigger -->
    <style>
      /* Prevent lower-section FOUC before GSAP initialises; keep hero paintable for LCP. */
      [data-scene]:not(#hero) {
        opacity: 0;
      }
    </style>
  </head>
  <body>
    <!-- Fixed parallax stage — layers driven by global scroll progress.
         MUST stay a sibling OUTSIDE #smooth-wrapper so ScrollSmoother's
         transform never moves it; it remains truly fixed behind content. -->
    <div id="scroll-stage" aria-hidden="true" data-scene="backdrop">
      <div class="stage-layer" id="stage-atmosphere">
        <!-- atmosphere.webp loaded by controller when media is ready -->
      </div>
      <div class="stage-layer" id="stage-mid-glass">
        <!-- mid-glass.webp -->
      </div>
      <div class="stage-layer" id="stage-particles">
        <!-- particles.webp -->
      </div>
    </div>

    <!-- ScrollSmoother DOM contract: #smooth-wrapper > #smooth-content.
         ScrollSmoother (controller.ts) applies the fixed/overflow styles to
         the wrapper and transforms the content. Under reduced motion the
         controller skips create() and these stay plain divs (native scroll). -->
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <!-- Page content scrolls above the fixed stage -->
        <main id="scroll-content">
          <slot />
        </main>
      </div>
    </div>

    <!-- GSAP ScrollTrigger controller — deferred so static hero content can paint first. -->
    <script>
      const mountScrollController = () => import('../scripts/scroll/controller.ts');
      const requestIdle = window.requestIdleCallback;

      if (requestIdle) {
        requestIdle(mountScrollController, { timeout: 1200 });
      } else {
        globalThis.setTimeout(mountScrollController, 800);
      }
    </script>
  </body>
</html>
