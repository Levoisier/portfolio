---
/**
 * The single page (ARCHITECTURE.md → Runtime overview). The asset manifest is inlined at build
 * time — nothing fetches it at runtime — and the pre-paint script applies the stored language
 * and the pixel size before anything renders.
 */
import '../styles/tokens.css';
import '../styles/shell.css';
import Hud from '../components/Hud.astro';
import Loading from '../components/Loading.astro';
import Pad from '../components/Pad.astro';
import Panels from '../components/panels/Panels.astro';
import { inlineJson, readRuntimeManifest } from '../assets/inline';
import { profile } from '../content';
import { DEFAULT_LANG, HTML_LANG, LANG_STORAGE_KEY } from '../i18n/lang';
import { ui } from '../i18n/ui';

const manifest = readRuntimeManifest();
const roles = (lang: 'es' | 'en') => profile.roles.map((r) => r[lang]).join(' · ');
---

<!doctype html>
<html lang={HTML_LANG[DEFAULT_LANG]} data-lang={DEFAULT_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={profile.summary[DEFAULT_LANG]} />
    <title>{profile.name} — {roles(DEFAULT_LANG)}</title>
    <script is:inline define:vars={{ key: LANG_STORAGE_KEY, htmlLang: HTML_LANG }}>
      try {
        const stored = localStorage.getItem(key);
        if (stored && stored in htmlLang) {
          document.documentElement.lang = htmlLang[stored];
          document.documentElement.dataset.lang = stored;
        }
      } catch {
        // Blocked storage: keep the default language.
      }
      // Loading-screen pixel: a whole number of device px (about 2 CSS px).
      const k = Math.max(1, Math.round(2 * devicePixelRatio));
      document.documentElement.style.setProperty('--px', `${k / devicePixelRatio}px`);
    </script>
  </head>
  <body>
    <h1 class="sr-only">
      {profile.name} — <span lang="es-419">{roles('es')}</span><span lang="en">{roles('en')}</span>
    </h1>
    <script is:inline type="application/json" id="assets" set:html={inlineJson(manifest)} />
    <Loading manifest={manifest} />
    <div id="screen"></div>
    <Hud />
    <Pad />
    <div id="panels">
      <Panels />
    </div>
    <div id="menu" hidden></div>
    <noscript>
      <p class="noscript">
        <span lang="es-419">{ui.noscript.es}</span><span lang="en">{ui.noscript.en}</span>
      </p>
    </noscript>
    <script>
      import '../ui/main';
    </script>
  </body>
</html>
