---
/* GlassSurface — reusable liquid-glass material wrapper (v4 Phase 25).
   Renders the .liquid-glass surface (translucent fill + rim + specular sheen);
   the sheen drift is decorative.
   Pass `class` for layout/padding (Tailwind); the material itself is tokenized
   in tokens.css / global.css — never hardcode colors here. */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['liquid-glass', className]}>
  <slot />
</div>
