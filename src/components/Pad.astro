---
/**
 * The touch pad (BACKLOG.md Phase 6 — ARCHITECTURE.md → Layout modes, Input → Touch pad):
 * D-pad ◀ ▶ bottom-left, B (interact / close) and A (jump) bottom-right, overlaid on the bottom
 * of the full-screen game in both touch modes. There is no START: the HUD's Map button is always
 * on screen. Markup only — `shell.css`'s `html[data-mode]` sets the mode (from
 * `src/shared/layout-mode.ts`) and `src/ui/pad.ts` does the pointer handling. `aria-label`s are
 * set client-side (bilingual, like the HUD prompt) so they are never missing here.
 */
---

<div id="pad" class="pad">
  <div class="pad__dpad">
    <button type="button" class="pad__btn pad__btn--dir" data-pad-btn="left">
      <span aria-hidden="true">◀</span>
    </button>
    <button type="button" class="pad__btn pad__btn--dir" data-pad-btn="right">
      <span aria-hidden="true">▶</span>
    </button>
  </div>
  <div class="pad__actions">
    <button type="button" class="pad__btn pad__btn--face pad__btn--b" data-pad-btn="b">
      <span aria-hidden="true">B</span>
    </button>
    <button type="button" class="pad__btn pad__btn--face pad__btn--a" data-pad-btn="a">
      <span aria-hidden="true">A</span>
    </button>
  </div>
</div>

<style>
  .pad {
    display: none;
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-pad);
    align-items: flex-end;
    justify-content: space-between;
    padding: var(--space-6) max(var(--space-4), env(safe-area-inset-right))
      max(var(--space-4), env(safe-area-inset-bottom))
      max(var(--space-4), env(safe-area-inset-left));
    /* Chrome only — the buttons themselves decide what happens (Golden Rule 7: the game never
     * touches these elements); the strip must not eat taps meant for the canvas underneath. */
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--c-navy-950) 55%, transparent)
    );
  }

  html[data-mode='handheld'] .pad,
  html[data-mode='landscape-touch'] .pad {
    display: flex;
  }

  .pad__dpad,
  .pad__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    pointer-events: none;
  }

  .pad__btn {
    pointer-events: auto;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: var(--pad-btn, 64px);
    height: var(--pad-btn, 64px);
    margin: 0;
    padding: 0;
    border: 2px solid var(--c-ink-900);
    color: var(--c-paper-100);
    font-family: var(--font-display);
    line-height: 1;
    /* A 2-px light top edge and dark bottom edge: a raised pixel button. */
    box-shadow:
      inset 0 2px 0 color-mix(in srgb, var(--c-white) 22%, transparent),
      inset 0 -3px 0 color-mix(in srgb, var(--c-ink-900) 45%, transparent);
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .pad__btn[data-pressed] {
    box-shadow: inset 0 3px 0 color-mix(in srgb, var(--c-ink-900) 45%, transparent);
  }

  .pad__btn--dir {
    border-radius: 10px;
    border-color: var(--c-ink-500);
    background: color-mix(in srgb, var(--c-ink-800) 72%, transparent);
    font-size: 1.6rem;
  }

  .pad__btn--dir[data-pressed] {
    background: color-mix(in srgb, var(--c-ink-600) 85%, transparent);
  }

  .pad__btn--face {
    border-radius: 50%;
    font-size: 1.4rem;
  }

  .pad__btn--b {
    background: var(--c-amber-600);
    color: var(--c-ink-900);
  }

  .pad__btn--b[data-pressed] {
    background: var(--c-amber-400);
  }

  .pad__btn--a {
    background: var(--c-scarlet-700);
  }

  .pad__btn--a[data-pressed] {
    background: var(--c-scarlet-500);
  }

  html[data-mode='landscape-touch'] .pad {
    --pad-btn: 56px;
    padding-top: var(--space-2);
    padding-bottom: max(var(--space-2), env(safe-area-inset-bottom));
  }

  /* A panel or the menu is open: it fills the screen, and only B (which closes it, like Esc)
   * stays on top of it — the rest of the pad has nothing to do until it closes. */
  html[data-modal] .pad {
    background: none;
  }

  html[data-modal] .pad__dpad,
  html[data-modal] .pad__btn--a {
    visibility: hidden;
  }
</style>
