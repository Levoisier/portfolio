---
/**
 * The handheld pad (BACKLOG.md Phase 6 — ARCHITECTURE.md → Layout modes, Input → Touch pad):
 * D-pad ◀ ▶, A (jump), B (interact / close), START (menu). Markup only — `shell.css`'s
 * `html[data-mode]` rules (set by `src/shared/layout-mode.ts`) show it only under `handheld`
 * (bottom half of the viewport) and `landscape-touch` (a translucent overlay); `src/ui/pad.ts`
 * does the pointer handling. `aria-label`s are set client-side (bilingual, like the HUD prompt)
 * so they are never missing here.
 */
---

<div id="pad" class="pad">
  <div class="pad__dpad">
    <button type="button" class="pad__btn pad__btn--dir" data-pad-btn="left">
      <span aria-hidden="true">◀</span>
    </button>
    <button type="button" class="pad__btn pad__btn--dir" data-pad-btn="right">
      <span aria-hidden="true">▶</span>
    </button>
  </div>
  <button type="button" class="pad__btn pad__btn--start" data-pad-btn="start">
    <span aria-hidden="true">START</span>
  </button>
  <div class="pad__actions">
    <button type="button" class="pad__btn pad__btn--face pad__btn--b" data-pad-btn="b">
      <span aria-hidden="true">B</span>
    </button>
    <button type="button" class="pad__btn pad__btn--face pad__btn--a" data-pad-btn="a">
      <span aria-hidden="true">A</span>
    </button>
  </div>
</div>

<style>
  .pad {
    display: none;
    position: fixed;
    z-index: var(--z-pad);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* Chrome only — the buttons themselves decide what happens (Golden Rule 7: the game never
     * touches these elements); the container just must not eat taps meant for the canvas
     * underneath in `landscape-touch` (a translucent overlay, not a solid panel). */
    pointer-events: none;
  }

  .pad__dpad,
  .pad__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    pointer-events: none;
  }

  .pad__btn {
    pointer-events: auto;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-width: 48px;
    min-height: 48px;
    margin: 0;
    padding: 0;
    border: 2px solid var(--c-ink-900);
    border-radius: 0;
    background: var(--c-ink-600);
    color: var(--c-paper-100);
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1;
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .pad__btn[data-pressed] {
    background: var(--c-ink-500);
  }

  .pad__btn--dir {
    width: 56px;
    height: 56px;
    font-size: 1.5rem;
  }

  .pad__btn--face {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 1.1rem;
  }

  .pad__btn--b {
    background: var(--c-amber-600);
    color: var(--c-ink-900);
  }

  .pad__btn--b[data-pressed] {
    background: var(--c-amber-400);
  }

  .pad__btn--a {
    background: var(--c-scarlet-700);
  }

  .pad__btn--a[data-pressed] {
    background: var(--c-scarlet-500);
  }

  .pad__btn--start {
    min-width: 96px;
    height: 48px;
    letter-spacing: 0.08em;
  }

  html[data-mode='handheld'] .pad {
    display: flex;
    top: 50dvh;
    right: 0;
    bottom: 0;
    left: 0;
    padding: var(--space-4) max(var(--space-4), env(safe-area-inset-right))
      max(var(--space-4), env(safe-area-inset-bottom))
      max(var(--space-4), env(safe-area-inset-left));
    background: var(--c-ink-800);
  }

  html[data-mode='landscape-touch'] .pad {
    display: flex;
    inset: auto 0 0 0;
    padding: var(--space-2) max(var(--space-6), env(safe-area-inset-right))
      max(var(--space-2), env(safe-area-inset-bottom))
      max(var(--space-6), env(safe-area-inset-left));
    background: color-mix(in srgb, var(--c-navy-950) 45%, transparent);
  }
</style>
