---
/**
 * Stand-in panel for a stop whose own phase has not merged yet: the Reagent lab (Phase 9) — the
 * menu already lists it (`components/Menu.astro`), so selecting it must open *something* rather
 * than silently do nothing. Titled with the stop's own name; the body is a generic placeholder. A
 * later phase replaces this entry with its real panel — the id stays the same, so nothing else
 * (visited marks, deep links, the menu) needs to change.
 *
 * The classified wing and its 4 dossier stands used to stand in here too (Phase 7); Phase 8
 * replaced them: the vault (`classified`) opens no DOM panel at all (GAME_DESIGN.md → Canonical
 * ids — interacting with it rolls its door aside instead, `stations/Vault.ts`), and the 4 dossier
 * ids now have their real panel (`ConfidentialPanel.astro`).
 */
import '../../styles/panel.css';
import { LANGS } from '../../content';
import { HTML_LANG } from '../../i18n/lang';
import { ui } from '../../i18n/ui';
import type { Localized } from '../../content/types';

const stubs: { id: string; title: Localized }[] = [{ id: 'lab', title: ui.menuLab }];
---

{
  stubs.map((stub) => (
    <section id={`panel-${stub.id}`} data-panel={stub.id} hidden>
      {LANGS.map((lang) => (
        <div
          class="panel"
          lang={HTML_LANG[lang]}
          role="dialog"
          aria-modal="true"
          aria-labelledby={`panel-${stub.id}-title-${lang}`}
          tabindex="-1"
        >
          <button type="button" class="panel__close" data-panel-close aria-label={ui.close[lang]}>
            <span aria-hidden="true">×</span>
          </button>
          <h2 id={`panel-${stub.id}-title-${lang}`} class="panel__title">
            {stub.title[lang]}
          </h2>
          <p class="panel__desc">{ui.stubBody[lang]}</p>
        </div>
      ))}
    </section>
  ))
}
