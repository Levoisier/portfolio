---
/**
 * The 6 project panels (BACKLOG.md Phase 5 — ARCHITECTURE.md → Stations & panels), pre-rendered
 * at build time from `src/content/projects.ts`, once per language. `src/ui/panels.ts` un-hides
 * `<section data-panel>`, traps focus and wires Esc/close; the global `[lang]` visibility rule in
 * `shell.css` picks the active language — this component never reads `html[data-lang]` itself.
 *
 * Transcolombia's `stack` is intentionally empty until Cristian sends it (AGENTS.md): the stack
 * heading/list is only rendered when a project actually has one.
 */
import { LANGS, projects } from '../../content';
import { HTML_LANG } from '../../i18n/lang';
import { ui } from '../../i18n/ui';
---

{
  projects.map((project) => (
    <section id={`panel-${project.id}`} data-panel={project.id} hidden>
      {LANGS.map((lang) => (
        <div
          class="panel"
          lang={HTML_LANG[lang]}
          role="dialog"
          aria-modal="true"
          aria-labelledby={`panel-${project.id}-title-${lang}`}
          tabindex="-1"
        >
          <button type="button" class="panel__close" data-panel-close aria-label={ui.close[lang]}>
            <span aria-hidden="true">×</span>
          </button>
          <h2 id={`panel-${project.id}-title-${lang}`} class="panel__title">
            {project.title}
          </h2>
          <p class="panel__desc">{project.description[lang]}</p>
          {project.stack.length > 0 && (
            <>
              <h3 class="panel__subheading">{ui.stackHeading[lang]}</h3>
              <ul class="panel__stack">
                {project.stack.map((s) => (
                  <li class="panel__chip">{s}</li>
                ))}
              </ul>
            </>
          )}
          {project.platformNote && <p class="panel__platform">{project.platformNote[lang]}</p>}
          {project.liveUrl && (
            <a
              class="panel__link"
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={project.liveAriaLabel?.[lang]}
            >
              {ui.viewLive[lang]} ↗
            </a>
          )}
          {project.screenshots && project.screenshots.length > 0 && (
            <div class="gallery" data-gallery>
              <ul class="gallery__grid">
                {project.screenshots.map((shot, i) => (
                  <li>
                    <button
                      type="button"
                      class="gallery__thumb"
                      data-gallery-open
                      data-index={i}
                      data-src={shot.src}
                      data-alt={shot.alt[lang]}
                    >
                      <img
                        src={shot.thumb}
                        alt={shot.alt[lang]}
                        width={shot.width}
                        height={shot.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  </li>
                ))}
              </ul>
              <div
                class="gallery__lightbox"
                data-gallery-lightbox
                role="dialog"
                aria-modal="true"
                aria-label={ui.galleryClose[lang]}
                hidden
              >
                <button
                  type="button"
                  class="gallery__nav gallery__nav--prev"
                  data-gallery-prev
                  aria-label={ui.galleryPrev[lang]}
                >
                  ‹
                </button>
                <img class="gallery__full" data-gallery-image alt="" />
                <button
                  type="button"
                  class="gallery__nav gallery__nav--next"
                  data-gallery-next
                  aria-label={ui.galleryNext[lang]}
                >
                  ›
                </button>
                <button
                  type="button"
                  class="gallery__close"
                  data-gallery-close
                  aria-label={ui.galleryClose[lang]}
                >
                  <span aria-hidden="true">×</span>
                </button>
              </div>
            </div>
          )}
        </div>
      ))}
    </section>
  ))
}

<style>
  section[data-panel] {
    position: fixed;
    inset: 0;
    z-index: var(--z-panel);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    background: color-mix(in srgb, var(--c-navy-950) 72%, transparent);
  }

  .panel {
    position: relative;
    width: min(92vw, 640px);
    max-height: min(86dvh, 720px);
    overflow-y: auto;
    box-sizing: border-box;
    padding: var(--space-6);
    background: var(--color-surface);
    color: var(--color-text);
    border: var(--pixel-border) solid var(--c-ink-900);
    box-shadow: 0 0 0 var(--pixel-border) var(--c-navy-400);
    font-family: var(--font-body);
  }

  .panel:focus-visible {
    outline: var(--pixel-border) solid var(--color-focus);
    outline-offset: 2px;
  }

  .panel__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: var(--space-8);
    height: var(--space-8);
    border: 2px solid var(--c-navy-400);
    background: var(--c-navy-700);
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .panel__close:hover {
    background: var(--c-navy-500);
  }

  .panel__title {
    margin: 0 var(--space-8) var(--space-2) 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .panel__desc {
    margin: 0 0 var(--space-4);
    line-height: 1.5;
  }

  .panel__subheading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .panel__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .panel__chip {
    padding: var(--space-1) var(--space-3);
    background: var(--c-navy-700);
    color: var(--c-paper-100);
    font-size: 0.85rem;
    border: 1px solid var(--c-navy-400);
  }

  .panel__platform {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .panel__link {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--c-white);
    font-family: var(--font-display);
    text-decoration: none;
  }

  .panel__link:hover,
  .panel__link:focus-visible {
    background: var(--c-scarlet-700);
  }

  /* ─── Fiora's gallery ─────────────────────────────────────────────────── */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid var(--c-navy-400);
    background: var(--c-navy-950);
    cursor: pointer;
    line-height: 0;
  }

  .gallery__thumb:hover,
  .gallery__thumb:focus-visible {
    border-color: var(--color-focus);
  }

  .gallery__thumb img {
    width: 100%;
    height: auto;
    display: block;
  }

  .gallery__lightbox {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-panel) + 1);
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--c-navy-950) 92%, transparent);
  }

  .gallery__full {
    max-width: min(90vw, 480px);
    max-height: 86dvh;
    width: auto;
    height: auto;
    border: var(--pixel-border) solid var(--c-ink-900);
  }

  .gallery__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: var(--space-8);
    height: calc(var(--space-8) * 2);
    border: 2px solid var(--c-navy-400);
    background: var(--c-navy-700);
    color: var(--color-text);
    font-size: 1.5rem;
    cursor: pointer;
  }

  .gallery__nav--prev {
    left: var(--space-4);
  }

  .gallery__nav--next {
    right: var(--space-4);
  }

  .gallery__close {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    width: var(--space-8);
    height: var(--space-8);
    border: 2px solid var(--c-navy-400);
    background: var(--c-navy-700);
    color: var(--color-text);
    font-size: 1.25rem;
    cursor: pointer;
  }
</style>
