---
/**
 * HUD chrome (BACKLOG.md Phase 7 — GAME_DESIGN.md → HUD): a profile badge, Contact, the ES · EN
 * toggle, the sound toggle and the menu button, plus the interact prompt (Phase 5) and the
 * first-visit controls hint (Phase 7). Markup only — `src/ui/hud.ts`/`src/ui/hint.ts` do the
 * wiring; every dynamic label (aria-labels, Contact/menu/sound text) is applied client-side, the
 * same pattern `src/ui/pad.ts` already uses.
 */
import { versioned } from '../game/load-plan';
import type { RuntimeManifest } from '../assets/runtime';

interface Props {
  manifest: RuntimeManifest | null;
}
const { manifest } = Astro.props;
const portrait = manifest?.assets['panda-portrait'];
const img =
  portrait && portrait.source !== 'missing' && portrait.kind === 'sprite' ? portrait : null;
---

<div id="hud" class="hud">
  <div class="hud__slot hud__slot--left" data-slot="badge">
    <button type="button" class="hud__badge" data-hud-badge>
      {
        img && manifest && (
          <img
            class="hud__badge-img"
            src={versioned(img.url, manifest.hash)}
            alt=""
            width={img.width}
            height={img.height}
          />
        )
      }
    </button>
  </div>
  <div class="hud__slot hud__slot--right" data-slot="actions">
    <button type="button" class="hud__action" data-hud-contact>
      <svg class="hud__icon" viewBox="0 0 12 12" aria-hidden="true">
        <path
          d="M0 2h12v1H0zM0 9h12v1H0zM0 3h1v6H0zM11 3h1v6h-1zM1 3h1v1H1zM10 3h1v1h-1zM2 4h1v1H2zM9 4h1v1H9zM3 5h1v1H3zM8 5h1v1H8zM4 6h4v1H4z"
        ></path>
      </svg>
      <span class="hud__label" data-hud-contact-label></span>
    </button>
    <button type="button" class="hud__action hud__action--lang" data-hud-lang>
      <span data-lang-code="es">ES</span> · <span data-lang-code="en">EN</span>
    </button>
    <button
      type="button"
      class="hud__action hud__action--compact"
      data-hud-sound
      aria-pressed="false"
    >
      <svg class="hud__icon" viewBox="0 0 12 12" aria-hidden="true">
        <path d="M1 4h2v4H1zM3 3h1v6H3zM4 2h1v8H4zM5 1h1v10H5z"></path>
        <path data-icon="sound-on" d="M7 4h1v4H7zM9 2h1v8H9z"></path>
        <path data-icon="sound-off" d="M7 4h1v1H7zM10 4h1v1h-1zM8 5h2v2H8zM7 7h1v1H7zM10 7h1v1h-1z"
        ></path>
      </svg>
      <span class="hud__label" data-hud-sound-label></span>
    </button>
    <button type="button" class="hud__action hud__action--compact" data-hud-menu>
      <svg class="hud__icon" viewBox="0 0 12 12" aria-hidden="true">
        <path
          fill-rule="evenodd"
          d="M0 2h4v9H0zM1 3v7h2V3zM4 1h4v9H4zM5 2v7h2V2zM8 2h4v9H8zM9 3v7h2V3z"></path>
      </svg>
      <span class="hud__label" data-hud-menu-label></span>
    </button>
  </div>
  <div class="hud__bottom">
    <p class="hud__hint" data-slot="hint" hidden></p>
    <p class="hud__prompt" data-slot="prompt" aria-live="polite"></p>
  </div>
</div>

<style>
  .hud {
    position: fixed;
    inset: 0;
    z-index: var(--z-hud);
    pointer-events: none;
    padding: max(var(--space-2), env(safe-area-inset-top))
      max(var(--space-2), env(safe-area-inset-right))
      max(var(--space-2), env(safe-area-inset-bottom))
      max(var(--space-2), env(safe-area-inset-left));
  }

  .hud > * {
    pointer-events: auto;
  }

  .hud__slot--left {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
  }

  .hud__slot--right {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
    /* Safety net for very narrow screens: wrap rather than run under the badge. */
    max-width: calc(100vw - 72px);
  }

  .hud__badge,
  .hud__action {
    box-sizing: border-box;
    min-height: 44px;
    border: 2px solid var(--c-navy-500);
    border-radius: 6px;
    background: color-mix(in srgb, var(--c-navy-900) 82%, transparent);
    box-shadow: inset 0 -3px 0 color-mix(in srgb, var(--c-ink-900) 40%, transparent);
    cursor: pointer;
  }

  .hud__badge {
    display: grid;
    place-items: center;
    min-width: 44px;
    padding: 0;
  }

  .hud__badge-img {
    display: block;
    width: auto;
    height: 38px;
    image-rendering: pixelated;
  }

  .hud__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 0.875rem;
  }

  .hud__badge:hover,
  .hud__badge:focus-visible,
  .hud__action:hover,
  .hud__action:focus-visible {
    border-color: var(--c-navy-400);
    background: color-mix(in srgb, var(--c-navy-700) 90%, transparent);
  }

  .hud__icon {
    flex: none;
    width: 24px;
    height: 24px;
    fill: currentColor;
    shape-rendering: crispEdges;
  }

  [data-hud-sound][aria-pressed='true'] [data-icon='sound-off'],
  [data-hud-sound][aria-pressed='false'] [data-icon='sound-on'] {
    display: none;
  }

  [data-hud-sound][aria-pressed='false'] {
    color: var(--color-text-muted);
  }

  /* Phones: the sound and map buttons go icon-only (their names stay as aria-labels) so the
   * whole row fits on one line. */
  @media (max-width: 560px) {
    .hud__action {
      font-size: 0.8rem;
    }

    .hud__action--compact {
      justify-content: center;
      min-width: 44px;
      padding: var(--space-1);
    }

    .hud__action--compact .hud__label {
      display: none;
    }
  }

  /* Landscape phones are wide but short: same icon-only row, so the game keeps its sky. */
  html[data-mode='landscape-touch'] .hud__action--compact {
    justify-content: center;
    min-width: 44px;
    padding: var(--space-1);
  }

  html[data-mode='landscape-touch'] .hud__action--compact .hud__label {
    display: none;
  }

  .hud__action--lang [data-lang-code] {
    opacity: 0.6;
  }

  html[data-lang='es'] .hud__action--lang [data-lang-code='es'],
  html[data-lang='en'] .hud__action--lang [data-lang-code='en'] {
    color: var(--c-amber-400);
    opacity: 1;
  }

  /* The hint and the prompt share one bottom-centred column so a two-line hint never runs into
   * the prompt; in touch modes it sits above the pad (`--pad-clearance`, shell.css). */
  .hud__bottom {
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-6) + var(--pad-clearance, 0px));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: min(90vw, 480px);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hud__bottom > * {
    pointer-events: auto;
  }

  .hud__hint {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: 6px;
    background: color-mix(in srgb, var(--c-navy-950) 72%, transparent);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-align: center;
  }

  .hud__prompt {
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border-radius: 6px;
    background: color-mix(in srgb, var(--c-navy-950) 60%, transparent);
    font-family: var(--font-display);
    color: var(--color-text);
  }

  .hud__prompt:empty {
    display: none;
  }
</style>
