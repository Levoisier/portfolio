---

<section id="skills" class="portfolio-section overflow-hidden section-pad" data-scene="skills">
  <!-- molecule-a: continuity thread drifting behind the shelf (data-speed).
       Static under reduced motion. Desktop-gated, low opacity, behind content. -->
  <img
    src="/media/lab/molecule-a.webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    width="112"
    height="112"
    data-speed="0.85"
    class="pointer-events-none absolute right-1/4 top-12 hidden w-28 select-none opacity-[0.14] md:block"
  />

  <div class="relative mx-auto max-w-7xl">
    <div class="flex flex-col gap-8 md:flex-row md:items-stretch md:gap-12">
      <!-- Vertical display label — "reagent shelf" framing. -->
      <div class="flex shrink-0 items-baseline gap-4 md:flex-col md:items-start md:gap-6">
        <span
          class="font-display text-xs uppercase tracking-[0.3em]"
          style="color: var(--scarlet);"
        >
          // The Stack
        </span>
        <h2
          class="font-display uppercase leading-none tracking-[0.2em] md:[writing-mode:vertical-rl] md:rotate-180"
          style="font-size: var(--text-3xl); color: var(--paper);"
        >
          Reagents
        </h2>
      </div>

      <!-- Shelf: tile grid anchored left, glassware sitting on a bench line. -->
      <div class="relative flex-1">
        <!-- Glassware on the bench (behind tiles); rises in via data-speed. -->
        <div class="pointer-events-none absolute inset-0 z-0 hidden md:block" aria-hidden="true">
          <img
            src="/media/lab/flask-round.webp"
            alt=""
            loading="lazy"
            decoding="async"
            width="128"
            height="128"
            data-speed="1.15"
            class="absolute bottom-0 left-[6%] w-32 select-none opacity-[0.12]"
          />
          <img
            src="/media/lab/beaker-reaction.webp"
            alt=""
            loading="lazy"
            decoding="async"
            width="144"
            height="144"
            data-speed="1.1"
            class="absolute bottom-0 left-[24%] w-36 select-none opacity-[0.12]"
          />
        </div>

        <!-- Bench line -->
        <div
          class="absolute bottom-0 left-0 z-0 h-px w-full"
          aria-hidden="true"
          style="background: linear-gradient(90deg, transparent, var(--glass-border) 12%, var(--glass-border) 88%, transparent);"
        >
        </div>

        <!-- Periodic table grid -->
        <div
          id="skills-grid"
          class="relative z-10 flex flex-wrap justify-center gap-3 pb-10 md:justify-start"
          role="list"
          aria-label="Technology stack"
        >
          {
            elements.map((el) => (
              <div
                class="element-tile group relative cursor-default"
                role="listitem"
                data-category={el.category}
                data-skill-tile
                data-proficiency={el.proficiency}
                style={`--tile-color: ${el.categoryToken};`}
                tabindex="0"
                aria-label={`${el.name} — ${el.category} — ${el.proficiency}% proficiency`}
              >
                <div
                  class="relative flex h-20 w-16 flex-col items-center justify-center overflow-hidden border"
                  data-skill-card
                  style="border-color: var(--tile-color); background: color-mix(in srgb, var(--tile-color) 8%, var(--ink));"
                >
                  <span
                    class="font-display absolute left-1 top-1 leading-none"
                    style="font-size: 0.5rem; color: var(--tile-color); opacity: 0.7;"
                    aria-hidden="true"
                  >
                    {el.number}
                  </span>

                  <span
                    class="font-display font-bold leading-none"
                    style="font-size: var(--text-xl); color: var(--paper);"
                  >
                    {el.symbol}
                  </span>

                  <span
                    class="font-body mt-1 w-full truncate px-1 text-center leading-none"
                    style="font-size: 0.55rem; color: color-mix(in srgb, var(--paper) 70%, transparent);"
                  >
                    {el.name}
                  </span>

                  <span
                    class="font-body absolute bottom-1 right-1 leading-none opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
                    data-category-badge
                    style="font-size: 0.45rem; color: var(--tile-color);"
                    aria-hidden="true"
                  >
                    {el.category}
                  </span>

                  <span
                    class="absolute bottom-0 left-0 h-0.5 w-full origin-left"
                    data-proficiency-bar
                    style="background-color: var(--scarlet); transform: scaleX(0);"
                    aria-hidden="true"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Category legend -->
    <div
      class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start"
      aria-label="Category legend"
    >
      {
        [
          { label: 'Languages', token: 'var(--cat-languages)' },
          { label: 'Frontend', token: 'var(--cat-frontend)' },
          { label: 'Backend', token: 'var(--cat-backend)' },
          { label: 'Data/Auth', token: 'var(--cat-data-auth)' },
          { label: 'DevOps', token: 'var(--cat-devops)' },
          { label: 'AI', token: 'var(--cat-ai)' },
          { label: 'Enterprise', token: 'var(--cat-enterprise)' },
          { label: 'Testing', token: 'var(--cat-testing)' },
        ].map(({ label, token }) => (
          <span class="font-body flex items-center gap-2 text-xs" style={`color: var(--paper);`}>
            <span
              class="inline-block h-2.5 w-2.5 rounded-sm"
              style={`background-color: ${token};`}
              aria-hidden="true"
            />
            {label}
          </span>
        ))
      }
    </div>
  </div>
</section>
