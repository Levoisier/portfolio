];

// Split into three marquee rows (round-robin keeps each row category-mixed and
// visually balanced). Row directions: right / left / right.
const rows: Element[][] = [[], [], []];
elements.forEach((el, i) => {
  const target = rows[i % 3];
  if (target) target.push(el);
});

const rowDirections = ['right', 'left', 'right'] as const;

// Duplicate each row once so the CSS -50% translate loops seamlessly. The second
// copy is aria-hidden / untabbable — it's a visual clone, not a second listing.
const marqueeRows = rows.map((row, rowIndex) => ({
  direction: rowDirections[rowIndex] ?? 'left',
  items: [...row.map((el) => ({ el, dup: false })), ...row.map((el) => ({ el, dup: true }))],
}));
---

<section id="skills" class="portfolio-section overflow-hidden section-pad" data-scene="skills">
  <div class="relative mx-auto max-w-7xl">
    <div class="flex flex-col gap-8 md:flex-row md:items-stretch md:gap-12">
      <!-- Vertical display label -->
      <div class="flex shrink-0 items-baseline gap-4 md:flex-col md:items-start md:gap-6">
        <h2
          class="font-display uppercase leading-none tracking-[0.2em] md:mt-12 md:[writing-mode:vertical-rl] md:rotate-180 lg:mt-16"
          style="font-size: var(--text-3xl); color: var(--paper); text-shadow: 0 0 18px color-mix(in srgb, var(--scarlet) 42%, transparent);"
          data-i18n="skills.heading"
        >
          Mi Stack
        </h2>
      </div>

      <!-- Marquee column -->
      <div class="relative min-w-0 flex-1 pb-2">
        <GlassSurface class="liquid-glass--refractive-mobile mb-8 max-w-3xl px-5 py-4">
          <p
            class="font-body leading-relaxed"
            style="font-size: var(--text-base); color: var(--paper);"
            data-i18n="skills.description"
          >
            Lenguajes, frameworks, plataformas y herramientas de testing que uso para llevar
            proyectos a producción.
          </p>
        </GlassSurface>

        <!-- Three infinite marquee rows -->
        <div
          id="skills-grid"
          class="skills-marquee"
          role="list"
          aria-label="Stack tecnológico"
          data-i18n-aria="skills.grid-aria"
          data-skills-marquee
        >
          {
            marqueeRows.map((row) => (
              <div class="skill-row" data-skill-row>
                <div class="skill-track" data-marquee-dir={row.direction}>
                  {row.items.map(({ el, dup }) => (
                    <div
                      class="element-tile group relative cursor-default"
                      role={dup ? undefined : 'listitem'}
                      aria-hidden={dup ? 'true' : undefined}
                      data-category={el.category}
                      data-skill-tile
                      data-skill-dup={dup ? 'true' : undefined}
                      data-proficiency={el.proficiency}
                      style={`--tile-color: ${el.categoryToken};`}
                      tabindex={dup ? -1 : 0}
                      aria-label={
                        dup
                          ? undefined
                          : `${el.name} — ${el.category} — ${el.proficiency}% proficiency`
                      }
                    >
                      <div
                        class="skill-card relative flex h-20 w-16 flex-col items-center justify-center overflow-hidden border"
                        data-skill-card
                        style="border-color: var(--tile-color); background: color-mix(in srgb, var(--tile-color) 8%, var(--ink));"
                      >
                        <span
                          class="skill-liquid"
                          data-skill-liquid
                          style={`height: ${el.proficiency}%;`}
                          aria-hidden="true"
                        />

                        <span
                          class="font-display absolute left-1 top-1 z-10 leading-none"
                          style="font-size: 0.5rem; color: var(--tile-color); opacity: 0.7;"
                          aria-hidden="true"
                        >
                          {el.number}
                        </span>

                        <span
                          class="font-display relative z-10 font-bold leading-none"
                          style="font-size: var(--text-xl); color: var(--paper);"
                        >
                          {el.symbol}
                        </span>

                        <span
                          class="font-body relative z-10 mt-1 w-full truncate px-1 text-center leading-none"
                          style="font-size: 0.55rem; color: color-mix(in srgb, var(--paper) 70%, transparent);"
                        >
                          {el.name}
                        </span>

                        <span
                          class="font-body absolute bottom-1 right-1 z-10 leading-none opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
                          data-category-badge
                          style="font-size: 0.45rem; color: var(--tile-color);"
                          aria-hidden="true"
                        >
                          {el.category}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Category legend -->
    <div
      class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start"
      aria-label="Leyenda de categorías"
      data-i18n-aria="skills.legend-aria"
    >
      {
        [
          { label: 'Lenguajes', i18nKey: 'skills.legend.languages', token: 'var(--cat-languages)' },
          { label: 'Frontend', i18nKey: 'skills.legend.frontend', token: 'var(--cat-frontend)' },
          { label: 'Backend', i18nKey: 'skills.legend.backend', token: 'var(--cat-backend)' },
          {
            label: 'Datos/Auth',
            i18nKey: 'skills.legend.data-auth',
            token: 'var(--cat-data-auth)',
          },
          { label: 'DevOps', i18nKey: 'skills.legend.devops', token: 'var(--cat-devops)' },
          { label: 'IA', i18nKey: 'skills.legend.ai', token: 'var(--cat-ai)' },
          {
            label: 'Empresarial',
            i18nKey: 'skills.legend.enterprise',
            token: 'var(--cat-enterprise)',
          },
          { label: 'Testing', i18nKey: 'skills.legend.testing', token: 'var(--cat-testing)' },
        ].map(({ label, i18nKey, token }) => (
          <span class="font-body flex items-center gap-2 text-xs" style={`color: var(--paper);`}>
            <span
              class="inline-block h-2.5 w-2.5 rounded-sm"
              style={`background-color: ${token};`}
              aria-hidden="true"
            />
            <span data-i18n={i18nKey}>{label}</span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Infinite marquee ────────────────────────────────────────────────────────
     Three stacked rows. Each row clips its overflow; inside, a flex track holds
     the tiles twice over and slides by exactly one copy (-50%) on a linear loop,
     so the seam is invisible. Tiles carry a uniform right margin (not flex gap)
     so half the track width lands precisely on a tile boundary. */
  .skills-marquee {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .skill-row {
    /* `clip` + a small clip-margin lets the active tile's 1.08 scale grow past
       the row edge without being cropped (the old `overflow: hidden` cut its top
       and bottom), while still clipping the infinite marquee track. No extra row
       spacing, no scrollbar. The horizontal edges stay covered by the mask. */
    overflow: clip;
    overflow-clip-margin: 0.5rem;
    /* Fade the horizontal edges so tiles slide in/out instead of hard-clipping. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .skill-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .skill-track > .element-tile {
    margin-right: 0.75rem;
    flex: 0 0 auto;
  }

  .skill-track[data-marquee-dir='left'] {
    animation: skill-marquee-left 46s linear infinite;
  }

  .skill-track[data-marquee-dir='right'] {
    animation: skill-marquee-right 46s linear infinite;
  }

  /* Pause the row the pointer is resting on so a tile can be read/inspected. */
  .skill-row:hover .skill-track,
  .skill-track:focus-within {
    animation-play-state: paused;
  }

  @keyframes skill-marquee-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes skill-marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* ── Liquid proficiency fill ─────────────────────────────────────────────────
     Each tile is a vessel: the fill's HEIGHT is the proficiency level (inline
     style), and activation slides it up from below the card (transform-only —
     the skills scene drives yPercent 100 → 0 plus a gentle rotation slosh).
     Wider than the card with a rounded top so the tilting surface reads as
     liquid, not a bar; the card's overflow-hidden crops the overhang. */
  .skill-liquid {
    position: absolute;
    left: -25%;
    bottom: 0;
    width: 150%;
    border-radius: 46% 40% 0 0 / 14px 10px 0 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--tile-color) 58%, var(--ink)),
      color-mix(in srgb, var(--tile-color) 30%, transparent)
    );
    box-shadow: 0 -2px 8px color-mix(in srgb, var(--tile-color) 40%, transparent);
    transform-origin: 50% 100%;
    pointer-events: none;
    will-change: transform;
  }
  /* NOTE: no CSS transform here on purpose. The skills section is opacity:0 until
     the controller mounts, so the resting fill is never seen pre-JS; the scene
     owns the position via yPercent from init. A CSS translateY here would seed a
     px baseline that GSAP adds its own yPercent onto (doubling the offset). */

  /* Slightly roomier rows + a touch more breathing space from md up. */
  @media (min-width: 768px) {
    .skills-marquee {
      gap: 1rem;
    }

    .skill-track > .element-tile {
      margin-right: 1rem;
    }
  }
</style>
