---

<section id="skills" class="portfolio-section overflow-hidden section-pad" data-scene="skills">
  <div class="relative mx-auto max-w-7xl">
    <div class="flex flex-col gap-8 md:flex-row md:items-stretch md:gap-12">
      <!-- Vertical display label -->
      <div class="flex shrink-0 items-baseline gap-4 md:flex-col md:items-start md:gap-6">
        <h2
          class="font-display uppercase leading-none tracking-[0.2em] md:mt-12 md:[writing-mode:vertical-rl] md:rotate-180 lg:mt-16"
          style="font-size: var(--text-3xl); color: var(--paper); text-shadow: 0 0 18px color-mix(in srgb, var(--scarlet) 42%, transparent);"
          data-i18n="skills.heading"
        >
          Mi Stack
        </h2>
      </div>

      <!-- Tile grid anchored to the label side. -->
      <div class="relative min-w-0 flex-1 pb-2">
        <GlassSurface class="liquid-glass--refractive-mobile mb-8 max-w-3xl px-5 py-4">
          <p
            class="font-body leading-relaxed"
            style="font-size: var(--text-base); color: var(--paper);"
            data-i18n="skills.description"
          >
            Lenguajes, frameworks, plataformas y herramientas de testing que uso para llevar
            proyectos a producción.
          </p>
        </GlassSurface>

        <!-- Periodic table grid -->
        <div
          id="skills-grid"
          class="flex flex-wrap justify-center gap-3 md:justify-start"
          role="list"
          aria-label="Stack tecnológico"
          data-i18n-aria="skills.grid-aria"
        >
          {
            elements.map((el) => (
              <div
                class="element-tile group relative cursor-default"
                role="listitem"
                data-category={el.category}
                data-skill-tile
                data-proficiency={el.proficiency}
                style={`--tile-color: ${el.categoryToken}; --tile-group: ${el.group}; --tile-period: ${el.period};`}
                tabindex="0"
                aria-label={`${el.name} — ${el.category} — ${el.proficiency}% proficiency`}
              >
                <div
                  class="skill-card relative flex h-20 w-16 flex-col items-center justify-center overflow-hidden border"
                  data-skill-card
                  style="border-color: var(--tile-color); background: color-mix(in srgb, var(--tile-color) 8%, var(--ink));"
                >
                  <span
                    class="font-display absolute left-1 top-1 leading-none"
                    style="font-size: 0.5rem; color: var(--tile-color); opacity: 0.7;"
                    aria-hidden="true"
                  >
                    {el.number}
                  </span>

                  <span
                    class="font-display font-bold leading-none"
                    style="font-size: var(--text-xl); color: var(--paper);"
                  >
                    {el.symbol}
                  </span>

                  <span
                    class="font-body mt-1 w-full truncate px-1 text-center leading-none"
                    style="font-size: 0.55rem; color: color-mix(in srgb, var(--paper) 70%, transparent);"
                  >
                    {el.name}
                  </span>

                  <span
                    class="font-body absolute bottom-1 right-1 leading-none opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
                    data-category-badge
                    style="font-size: 0.45rem; color: var(--tile-color);"
                    aria-hidden="true"
                  >
                    {el.category}
                  </span>

                  <span
                    class="absolute bottom-0 left-0 h-0.5 w-full origin-left"
                    data-proficiency-bar
                    style="background-color: var(--scarlet); transform: scaleX(0);"
                    aria-hidden="true"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Category legend -->
    <div
      class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start"
      aria-label="Leyenda de categorías"
      data-i18n-aria="skills.legend-aria"
    >
      {
        [
          { label: 'Lenguajes', i18nKey: 'skills.legend.languages', token: 'var(--cat-languages)' },
          { label: 'Frontend', i18nKey: 'skills.legend.frontend', token: 'var(--cat-frontend)' },
          { label: 'Backend', i18nKey: 'skills.legend.backend', token: 'var(--cat-backend)' },
          {
            label: 'Datos/Auth',
            i18nKey: 'skills.legend.data-auth',
            token: 'var(--cat-data-auth)',
          },
          { label: 'DevOps', i18nKey: 'skills.legend.devops', token: 'var(--cat-devops)' },
          { label: 'IA', i18nKey: 'skills.legend.ai', token: 'var(--cat-ai)' },
          {
            label: 'Empresarial',
            i18nKey: 'skills.legend.enterprise',
            token: 'var(--cat-enterprise)',
          },
          { label: 'Testing', i18nKey: 'skills.legend.testing', token: 'var(--cat-testing)' },
        ].map(({ label, i18nKey, token }) => (
          <span class="font-body flex items-center gap-2 text-xs" style={`color: var(--paper);`}>
            <span
              class="inline-block h-2.5 w-2.5 rounded-sm"
              style={`background-color: ${token};`}
              aria-hidden="true"
            />
            <span data-i18n={i18nKey}>{label}</span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    #skills-grid {
      display: grid;
      width: 100%;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: clamp(0.38rem, 0.58vw, 0.6rem);
      align-items: stretch;
      justify-content: start;
    }

    .element-tile {
      grid-column: var(--tile-group);
      grid-row: var(--tile-period);
    }

    .skill-card {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1.04;
      align-items: stretch;
      padding: clamp(0.48rem, 0.66vw, 0.66rem);
      box-shadow:
        inset 0 0 0 1px color-mix(in srgb, var(--tile-color) 34%, transparent),
        0 0 18px color-mix(in srgb, var(--tile-color) 12%, transparent);
    }

    .skill-card::before {
      content: '';
      position: absolute;
      inset: clamp(0.24rem, 0.36vw, 0.34rem);
      border: 1px solid color-mix(in srgb, var(--tile-color) 26%, transparent);
      opacity: 0.62;
      pointer-events: none;
    }

    .skill-card > span:nth-child(1) {
      left: clamp(0.44rem, 0.56vw, 0.6rem);
      top: clamp(0.36rem, 0.48vw, 0.52rem);
      font-size: clamp(0.5rem, 0.62vw, 0.62rem) !important;
    }

    .skill-card > span:nth-child(2) {
      margin-top: clamp(0.62rem, 0.78vw, 0.88rem);
      font-size: clamp(1.22rem, 1.82vw, 1.95rem) !important;
    }

    .skill-card > span:nth-child(3) {
      margin-top: clamp(0.22rem, 0.36vw, 0.38rem);
      padding-inline: 0.12rem;
      font-size: clamp(0.5rem, 0.64vw, 0.66rem) !important;
      white-space: normal;
      line-height: 1.05;
    }

    .skill-card > span:nth-child(4) {
      bottom: clamp(0.36rem, 0.5vw, 0.54rem);
      right: clamp(0.44rem, 0.56vw, 0.6rem);
      font-size: clamp(0.42rem, 0.5vw, 0.52rem) !important;
      opacity: 0.72;
    }
  }

  @media (min-width: 1320px) {
    #skills-grid {
      gap: 0.68rem;
    }

    .skill-card {
      aspect-ratio: 1 / 1.08;
    }
  }
</style>
