---
/* CONFIDENTIAL PROJECTS SECTION
   GOLDEN RULE: NO screenshots, NO links, NO client/employer names.
   "Redacted blueprint" cards — industry, role, abstracted stack, impact.
   Blueprint aesthetic: dark navy + grid + scarlet redaction bars.
   Visual treatment: see BACKLOG item confidential-card-treatment.
*/

interface ConfidentialProject {
  industry: string;
  role: string;
  stack: string[];
  impact: string;
  duration: string;
  teamSize: string;
}

const confidentialProjects: ConfidentialProject[] = [
  {
    industry: 'E-Commerce / Retail',
    role: 'Full Stack Developer',
    stack: ['Next.js', 'React', 'TypeScript', 'Auth', 'Wompi', 'ERP'],
    impact:
      'Desarrollé una plataforma de ecommerce personalizada con autenticación, gestión de perfil de usuario, seguimiento de pedidos, sincronización con ERP, pagos Wompi, y flujo de aprobación de transferencias bancarias manuales.',
    duration: '10+ meses',
    teamSize: '4-6',
  },
  {
    industry: 'Logística / Almacenamiento',
    role: 'Full Stack Developer',
    stack: ['Next.js', 'React', 'TypeScript', 'Python', 'AWS EKS'],
    impact:
      'Entregué un WMS conectado a pedidos de ecommerce, con asignación inteligente de tareas, automatizaciones operativas, tickets de incidencias, reportes de KPIs, y flujos de despacho de salida.',
    duration: '12+ meses',
    teamSize: '6-8',
  },
  {
    industry: 'Operaciones de Ventas',
    role: 'Full Stack Developer',
    stack: ['Next.js', 'React', 'TypeScript', 'Python', 'AWS EKS'],
    impact:
      'Desarrollé un CRM con flujos de seguimiento automatizados, pipelines de leads y cuentas, colas de tareas, historial de actividad, vistas de reportes, y control de acceso por roles.',
    duration: '8+ meses',
    teamSize: '4-6',
  },
  {
    industry: 'Finanzas / ERP',
    role: 'Full Stack Developer',
    stack: ['Python', 'ERP', 'DIAN', 'Billing', 'Accounting'],
    impact:
      'Implementé un módulo de ERP financiero que cubre facturación electrónica a través de DIAN, operaciones de facturación, flujos de contabilidad, seguimiento de estados de documentos, y registros listos para auditoría.',
    duration: '9+ meses',
    teamSize: '4-6',
  },
];
---

<section
  id="confidential"
  class="portfolio-section overflow-hidden section-pad"
  data-scene="confidential"
  style="background-color: var(--navy);"
>
  <div
    class="blueprint-grid pointer-events-none absolute inset-0 opacity-60"
    data-blueprint-grid-pulse
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="mb-12 flex flex-col gap-2">
      <span
        class="font-display text-xs uppercase tracking-widest"
        style="color: var(--scarlet);"
        data-i18n="confidential.classified"
      >
        [CLASIFICADO]
      </span>
      <h2
        class="font-display uppercase tracking-widest"
        style="font-size: var(--text-2xl); color: var(--paper);"
        data-i18n="confidential.heading"
      >
        Trabajo Confidencial
      </h2>
      <p
        class="font-body max-w-prose"
        style="font-size: var(--text-sm); color: color-mix(in srgb, var(--paper) 60%, transparent);"
        data-i18n="confidential.subheading"
      >
        Proyectos bajo NDA resumidos para proteger la confidencialidad: sin capturas de pantalla,
        repositorios ni información identificable.
      </p>
    </div>

    <div class="flex flex-col gap-6" data-confidential-log>
      {
        confidentialProjects.map((project, i) => (
          <article
            class:list={[
              'confidential-card relative overflow-hidden border focus:outline-none',
              'md:grid md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:items-stretch',
              i % 2 === 0 ? 'lg:mr-[24%]' : 'lg:ml-[24%]',
            ]}
            style="border-color: var(--glass-border); background: color-mix(in srgb, var(--navy) 60%, transparent);"
            data-index={i}
            data-confidential-card
            tabindex="0"
            aria-label={`Proyecto confidencial: ${project.industry}`}
            data-i18n-aria={`confidential.${i}.card-aria`}
          >
            <span
              class="pointer-events-none absolute left-0 top-0 h-px w-full origin-left"
              data-scan-line
              style="background: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />

            <span
              class="pointer-events-none absolute left-0 top-0 h-6 w-6 border-l border-t"
              data-corner-accent
              style="border-color: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute right-0 top-0 h-6 w-6 border-r border-t"
              data-corner-accent
              style="border-color: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute bottom-0 left-0 h-6 w-6 border-b border-l"
              data-corner-accent
              style="border-color: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute bottom-0 right-0 h-6 w-6 border-b border-r"
              data-corner-accent
              style="border-color: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />

            <div
              class="relative flex min-h-36 flex-col justify-between gap-8 p-5"
              style="background: var(--scarlet); color: var(--on-scarlet);"
            >
              <div>
                <h3
                  class="font-display text-lg font-bold uppercase tracking-widest"
                  data-i18n={`confidential.${i}.industry`}
                >
                  {project.industry}
                </h3>
              </div>

              <span class="flex flex-col gap-1.5" aria-hidden="true">
                <span
                  class="relative block h-1.5 w-24 overflow-hidden"
                  data-redaction-bar
                  style="background: var(--navy);"
                >
                  <span
                    class="absolute inset-y-0 left-0 w-1/2"
                    data-redaction-sheen
                    style="background: linear-gradient(90deg, transparent, var(--paper), transparent); opacity: 0.35; transform: translateX(-120%);"
                  />
                </span>
                <span
                  class="relative block h-1.5 w-14 overflow-hidden"
                  data-redaction-bar
                  style="background: var(--navy);"
                >
                  <span
                    class="absolute inset-y-0 left-0 w-1/2"
                    data-redaction-sheen
                    style="background: linear-gradient(90deg, transparent, var(--paper), transparent); opacity: 0.35; transform: translateX(-120%);"
                  />
                </span>
              </span>
            </div>

            <div class="grid gap-5 p-5 md:grid-cols-2" data-confidential-content>
              <div class="md:col-span-1">
                <span
                  class="font-display text-xs uppercase tracking-widest"
                  style="color: var(--scarlet-soft);"
                  data-i18n="confidential.field.role"
                >
                  Rol
                </span>
                <p class="font-body mt-1" style="font-size: var(--text-sm); color: var(--paper);">
                  {project.role}
                </p>
              </div>

              <div class="md:col-span-1">
                <span
                  class="font-display text-xs uppercase tracking-widest"
                  style="color: var(--scarlet-soft);"
                  data-i18n="confidential.field.stack"
                >
                  Stack
                </span>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => (
                    <span
                      class="font-display rounded-sm px-1.5 py-0.5 text-xs"
                      style="background: var(--navy-dim); border: 1px solid var(--glass-border); color: var(--paper);"
                    >
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="md:col-span-2">
                <span
                  class="font-display text-xs uppercase tracking-widest"
                  style="color: var(--scarlet-soft);"
                  data-i18n="confidential.field.impact"
                >
                  Impacto
                </span>
                <p
                  class="font-body mt-1 leading-relaxed"
                  style="font-size: var(--text-sm); color: color-mix(in srgb, var(--paper) 80%, transparent);"
                  data-i18n={`confidential.${i}.impact`}
                >
                  {project.impact}
                </p>
              </div>

              <div
                class="flex gap-6 border-t pt-4 md:col-span-2"
                style="border-color: var(--glass-border);"
              >
                <div>
                  <span
                    class="font-display text-xs uppercase tracking-widest"
                    style="color: var(--scarlet-soft);"
                    data-i18n="confidential.field.duration"
                  >
                    Duración
                  </span>
                  <p
                    class="font-body mt-0.5 text-xs"
                    style="color: var(--paper);"
                    data-i18n={`confidential.${i}.duration`}
                  >
                    {project.duration}
                  </p>
                </div>
                <div>
                  <span
                    class="font-display text-xs uppercase tracking-widest"
                    style="color: var(--scarlet-soft);"
                    data-i18n="confidential.field.team"
                  >
                    Equipo
                  </span>
                  <p class="font-body mt-0.5 text-xs" style="color: var(--paper);">
                    {project.teamSize}
                  </p>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Mobile: horizontal auto-scrolling carousel ──────────────────────────────
     Matches the Projects section: below md the stacked blueprint files become a
     swipeable, snap-scrolling row that auto-drifts (scenes/confidential.ts) and
     yields to the reader on the first gesture. Cards keep their natural height
     (align-items: flex-start) instead of stretching to the tallest. Above md the
     original stacked layout is untouched. */
  @media (max-width: 767px) {
    [data-confidential-log] {
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 0.5rem;
      scroll-padding-inline: 0.5rem;
    }

    [data-confidential-log]::-webkit-scrollbar {
      display: none;
    }

    [data-confidential-card] {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }
  }
</style>
