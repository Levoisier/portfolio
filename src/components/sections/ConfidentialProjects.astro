---
/* CONFIDENTIAL PROJECTS SECTION
   GOLDEN RULE: NO screenshots, NO links, NO client/employer names.
   "Redacted blueprint" cards — industry, role, abstracted stack, impact.
   Blueprint aesthetic: dark navy + grid + scarlet redaction bars.
   Visual treatment: see BACKLOG item confidential-card-treatment.
*/

interface ConfidentialProject {
  industry: string;
  role: string;
  stack: string[];
  impact: string;
  duration: string;
  teamSize: string;
}

const confidentialProjects: ConfidentialProject[] = [
  {
    industry: 'E-Commerce / Retail',
    role: 'Full Stack Developer',
    stack: ['Next.js', 'React', 'TypeScript', 'Auth', 'Wompi', 'ERP'],
    impact:
      'Built a custom ecommerce platform with authentication, user profile management, order tracking, ERP synchronization, Wompi payments, and a manual bank-transfer approval flow.',
    duration: '10+ months',
    teamSize: '4-6',
  },
  {
    industry: 'Logistics / Warehousing',
    role: 'Full Stack Developer',
    stack: ['Next.js', 'React', 'TypeScript', 'Python', 'AWS EKS'],
    impact:
      'Delivered a WMS wired to ecommerce orders, with smart task assignment, operational automations, issue tickets, KPI reporting, and outbound shipping workflows.',
    duration: '12+ months',
    teamSize: '6-8',
  },
  {
    industry: 'Sales Operations',
    role: 'Full Stack Developer',
    stack: ['Next.js', 'React', 'TypeScript', 'Python', 'AWS EKS'],
    impact:
      'Built a CRM with automated follow-up flows, lead and account pipelines, task queues, activity history, reporting views, and role-based access control.',
    duration: '8+ months',
    teamSize: '4-6',
  },
  {
    industry: 'Finance / ERP',
    role: 'Full Stack Developer',
    stack: ['Python', 'ERP', 'DIAN', 'Billing', 'Accounting'],
    impact:
      'Implemented a financial ERP module covering electronic invoicing through DIAN, billing operations, accounting workflows, document state tracking, and audit-ready records.',
    duration: '9+ months',
    teamSize: '4-6',
  },
];
---

<section
  id="confidential"
  class="portfolio-section overflow-hidden section-pad"
  data-scene="confidential"
  style="background-color: var(--navy);"
>
  <div
    class="blueprint-grid pointer-events-none absolute inset-0 opacity-60"
    data-blueprint-grid-pulse
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="mb-12 flex flex-col gap-2">
      <span class="font-display text-xs uppercase tracking-widest" style="color: var(--scarlet);">
        [CLASSIFIED]
      </span>
      <h2
        class="font-display uppercase tracking-widest"
        style="font-size: var(--text-2xl); color: var(--paper);"
      >
        Confidential Work
      </h2>
      <p
        class="font-body max-w-prose"
        style="font-size: var(--text-sm); color: color-mix(in srgb, var(--paper) 60%, transparent);"
      >
        Client engagements under NDA. Details abstracted to protect confidentiality. No screenshots,
        repositories, or identifying information are disclosed.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        confidentialProjects.map((project, i) => (
          <article
            class="confidential-card relative overflow-hidden border"
            style="border-color: var(--glass-border); background: color-mix(in srgb, var(--navy) 60%, transparent);"
            data-index={i}
            data-confidential-card
            aria-label={`Confidential project: ${project.industry}`}
          >
            <span
              class="pointer-events-none absolute left-0 top-0 h-px w-full origin-left"
              data-scan-line
              style="background: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />

            <span
              class="pointer-events-none absolute left-0 top-0 h-6 w-6 border-l border-t"
              data-corner-accent
              style="border-color: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute right-0 top-0 h-6 w-6 border-r border-t"
              data-corner-accent
              style="border-color: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute bottom-0 left-0 h-6 w-6 border-b border-l"
              data-corner-accent
              style="border-color: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute bottom-0 right-0 h-6 w-6 border-b border-r"
              data-corner-accent
              style="border-color: var(--scarlet); opacity: 0;"
              aria-hidden="true"
            />

            <div
              class="relative flex items-center justify-between gap-4 px-4 py-3"
              style="background: var(--scarlet); color: var(--on-scarlet);"
            >
              <span class="font-display text-xs font-bold uppercase tracking-widest">
                {project.industry}
              </span>
              <span class="flex flex-col gap-1.5" aria-hidden="true">
                <span
                  class="relative block h-1.5 w-16 overflow-hidden"
                  data-redaction-bar
                  style="background: var(--navy);"
                >
                  <span
                    class="absolute inset-y-0 left-0 w-1/2"
                    data-redaction-sheen
                    style="background: linear-gradient(90deg, transparent, var(--paper), transparent); opacity: 0.35; transform: translateX(-120%);"
                  />
                </span>
                <span
                  class="relative block h-1.5 w-10 overflow-hidden"
                  data-redaction-bar
                  style="background: var(--navy);"
                >
                  <span
                    class="absolute inset-y-0 left-0 w-1/2"
                    data-redaction-sheen
                    style="background: linear-gradient(90deg, transparent, var(--paper), transparent); opacity: 0.35; transform: translateX(-120%);"
                  />
                </span>
              </span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <rect x="2" y="4" width="12" height="2" rx="1" />
                <rect x="2" y="8" width="8" height="2" rx="1" />
                <rect x="2" y="12" width="10" height="2" rx="1" />
              </svg>
            </div>

            <div class="flex flex-col gap-4 p-5" data-confidential-content>
              <div>
                <span
                  class="font-display text-xs uppercase tracking-widest"
                  style="color: var(--scarlet-soft);"
                >
                  Role
                </span>
                <p class="font-body mt-1" style="font-size: var(--text-sm); color: var(--paper);">
                  {project.role}
                </p>
              </div>

              <div>
                <span
                  class="font-display text-xs uppercase tracking-widest"
                  style="color: var(--scarlet-soft);"
                >
                  Stack
                </span>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => (
                    <span
                      class="font-display rounded-sm px-1.5 py-0.5 text-xs"
                      style="background: var(--navy-dim); border: 1px solid var(--glass-border); color: var(--paper);"
                    >
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div>
                <span
                  class="font-display text-xs uppercase tracking-widest"
                  style="color: var(--scarlet-soft);"
                >
                  Impact
                </span>
                <p
                  class="font-body mt-1 leading-relaxed"
                  style="font-size: var(--text-sm); color: color-mix(in srgb, var(--paper) 80%, transparent);"
                >
                  {project.impact}
                </p>
              </div>

              <div class="flex gap-6 border-t pt-4" style="border-color: var(--glass-border);">
                <div>
                  <span
                    class="font-display text-xs uppercase tracking-widest"
                    style="color: var(--scarlet-soft);"
                  >
                    Duration
                  </span>
                  <p class="font-body mt-0.5 text-xs" style="color: var(--paper);">
                    {project.duration}
                  </p>
                </div>
                <div>
                  <span
                    class="font-display text-xs uppercase tracking-widest"
                    style="color: var(--scarlet-soft);"
                  >
                    Team
                  </span>
                  <p class="font-body mt-0.5 text-xs" style="color: var(--paper);">
                    {project.teamSize}
                  </p>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
