---
/* FEATURED PROJECTS SECTION
   v3 experiment log: large editorial entries, formula-style stack chips,
   live links only. Confidential work belongs in ConfidentialProjects.
   Scroll choreography: see src/scripts/scroll/scenes/projects.ts.
*/

import GlassSurface from '../ui/GlassSurface.astro';

interface Project {
  title: string;
  description: string;
  stack: string[];
  liveUrl: string;
}

const projects: Project[] = [
  {
    title: 'Le Parché',
    description:
      'Sistema de marca y flujo de reservas para restaurante: fachada cinematográfica con Astro/GSAP combinada con operaciones de reservas impulsadas por Python.',
    stack: ['Astro', 'GSAP', 'React', 'TypeScript', 'Python'],
    liveUrl: 'https://leparche.com.co/',
  },
  {
    title: 'Maison Cielare',
    description:
      'Tienda en Shopify y configuración de comercio para una marca de ropa de dormir, con trabajo en tema Liquid, Mercado Pago, SellerChat, y manual de marca completo.',
    stack: ['Shopify', 'Liquid', 'HTML', 'CSS', 'Mercado Pago'],
    liveUrl: 'https://maisoncielare.com/',
  },
  {
    title: 'Orquestia',
    description:
      'Landing de agencia, portafolio, sistema de blog y manual de marca construidos de punta a punta con Next.js y TypeScript.',
    stack: ['Next.js', 'React', 'TypeScript', 'Blog', 'Brand System'],
    liveUrl: 'https://www.orquestia.io/',
  },
];
---

<section id="projects" class="portfolio-section overflow-hidden section-pad" data-scene="projects">
  <div class="relative mx-auto max-w-6xl">
    <div class="mb-14 max-w-3xl">
      <h2
        class="font-display max-w-4xl uppercase leading-none"
        style="font-size: var(--text-4xl); color: var(--paper); text-shadow: 0 0 18px color-mix(in srgb, var(--scarlet) 42%, transparent);"
        data-i18n="projects.heading"
      >
        PROYECTOS EN PRODUCCIÓN, RESULTADOS MEDIBLES
      </h2>
    </div>

    <div class="grid gap-0" data-projects-log>
      {
        projects.map((project, index) => (
          <article
            class:list={[
              'group grid gap-x-6 gap-y-4 border-t py-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-start md:gap-8 lg:py-14',
              index % 2 === 0 ? 'lg:mr-[24%]' : 'lg:ml-[24%]',
            ]}
            style="border-color: var(--glass-border);"
            data-project-entry
            data-project-index={index}
          >
            <GlassSurface class="liquid-glass--refractive-mobile min-w-0 px-5 py-5 md:px-7 md:py-7">
              <h3 class="font-display uppercase leading-none" style="font-size: var(--text-3xl);">
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-title-link inline-flex items-center gap-3"
                  aria-label={`Abrir sitio en vivo de ${project.title}`}
                  data-i18n-aria={`projects.${index}.live-aria`}
                  data-project-title
                >
                  <span>{project.title}</span>
                  <span class="project-title-link__mark" aria-hidden="true" />
                </a>
              </h3>

              <p
                class="font-body mt-5 max-w-3xl leading-relaxed"
                style="font-size: var(--text-base); color: var(--paper);"
                data-i18n={`projects.${index}.description`}
                data-project-desc
              >
                {project.description}
              </p>

              <div
                class="mt-6 flex flex-wrap items-center gap-2"
                aria-label={`${project.title} technology formula`}
                data-project-formula
              >
                {project.stack.map((tech, index) => (
                  <>
                    <span
                      class="font-display inline-flex min-h-9 items-center border px-3 text-xs uppercase tracking-widest"
                      style="border-color: var(--scarlet-dim); background: var(--glass-bg); color: var(--scarlet-soft);"
                      data-project-chip
                    >
                      {tech}
                    </span>
                    {index < project.stack.length - 1 && (
                      <span
                        class="font-display text-xs"
                        style="color: color-mix(in srgb, var(--paper) 46%, transparent);"
                        aria-hidden="true"
                      >
                        +
                      </span>
                    )}
                  </>
                ))}
              </div>
            </GlassSurface>

            <div
              class="hidden h-full w-px justify-self-end md:block"
              style="background: var(--scarlet-dim); transform-origin: top;"
              data-project-rule
            />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-title-link {
    position: relative;
    width: fit-content;
    max-width: 100%;
    color: var(--paper);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-shadow var(--duration-fast) var(--ease-out);
  }

  .project-title-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.16em;
    width: 100%;
    height: 0.12em;
    background: var(--scarlet);
    opacity: 0.32;
    transform: scaleX(0.34);
    transform-origin: left;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .project-title-link__mark {
    position: relative;
    display: inline-block;
    width: 1.38em;
    height: 1.38em;
    border: 1px solid var(--scarlet-dim);
    transform: translateY(-0.04em);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .project-title-link__mark::before,
  .project-title-link__mark::after {
    content: '';
    position: absolute;
    background: var(--scarlet);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .project-title-link__mark::before {
    left: 0.36em;
    top: 0.62em;
    width: 0.64em;
    height: 1px;
    transform-origin: right center;
  }

  .project-title-link__mark::after {
    right: 0.34em;
    top: 0.42em;
    width: 0.38em;
    height: 0.38em;
    background: transparent;
    border-right: 1px solid var(--scarlet);
    border-top: 1px solid var(--scarlet);
    transform: rotate(45deg);
  }

  .project-title-link:hover,
  .project-title-link:focus-visible {
    color: var(--paper);
    text-shadow: 0 0 16px color-mix(in srgb, var(--scarlet) 48%, transparent);
  }

  .project-title-link:hover::after,
  .project-title-link:focus-visible::after {
    opacity: 0.78;
    transform: scaleX(1);
  }

  .project-title-link:hover .project-title-link__mark,
  .project-title-link:focus-visible .project-title-link__mark {
    background-color: var(--scarlet);
    border-color: var(--scarlet);
    transform: translate(0.14em, -0.04em);
  }

  .project-title-link:hover .project-title-link__mark::before,
  .project-title-link:focus-visible .project-title-link__mark::before {
    background: var(--on-scarlet);
    transform: scaleX(1.18);
  }

  .project-title-link:hover .project-title-link__mark::after,
  .project-title-link:focus-visible .project-title-link__mark::after {
    border-color: var(--on-scarlet);
    transform: translateX(0.08em) rotate(45deg);
  }

  .project-title-link:focus-visible {
    outline: 2px solid var(--scarlet);
    outline-offset: 0.18em;
  }
</style>
