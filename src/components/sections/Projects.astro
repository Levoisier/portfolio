---
/* FEATURED PROJECTS SECTION
   Card/panel system: screenshot slot + stack chips + live/repo links.
   Public client/project entries only. Confidential work belongs in ConfidentialProjects.
   Scroll-reveal animation: see BACKLOG item projects-scroll-reveal.
*/

interface Project {
  title: string;
  description: string;
  stack: string[];
  liveUrl?: string;
  repoUrl?: string;
  imageAlt: string;
}

const projects: Project[] = [
  {
    title: 'Le Parche',
    description:
      'Animation-heavy restaurant brand site built with Astro, GSAP, React, and TypeScript, paired with a Python reservation system for booking flow operations.',
    stack: ['Astro', 'GSAP', 'React', 'TypeScript', 'Python'],
    liveUrl: 'https://leparche.com.co/',
    imageAlt: 'Brand site preview for Le Parche',
  },
  {
    title: 'Maison Cielare',
    description:
      "Women's pajama ecommerce on Shopify, customized with Liquid, Shopify's theme language, plus HTML and CSS. Connected Mercado Pago payments, a branded SellerChat WhatsApp bot, and created the brand manual.",
    stack: ['Shopify', 'Liquid', 'HTML', 'CSS', 'Mercado Pago'],
    liveUrl: 'https://maisoncielare.com/',
    imageAlt: 'Ecommerce storefront preview for Maison Cielare',
  },
  {
    title: 'Orquestia',
    description:
      'Software agency landing page and portfolio built end-to-end with Next.js, React, and TypeScript, including a blog system and a full brand manual.',
    stack: ['Next.js', 'React', 'TypeScript', 'Blog', 'Brand System'],
    liveUrl: 'https://www.orquestia.io/',
    imageAlt: 'Agency landing page preview for Orquestia',
  },
];
---

<section id="projects" class="portfolio-section overflow-hidden section-pad" data-scene="projects">
  <div
    class="pointer-events-none absolute right-0 top-16 hidden aspect-[4/5] w-64 select-none bg-contain bg-center bg-no-repeat opacity-20 lg:block"
    data-projects-accent
    data-projects-accent-src="/media/panda/panda-coding.png"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <h2
      class="font-display mb-12 uppercase tracking-widest"
      style="font-size: var(--text-2xl); color: var(--paper);"
    >
      Featured Projects
    </h2>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-projects-track>
      {
        projects.map((project, i) => (
          <article
            class="project-card group relative flex flex-col overflow-hidden border"
            style="border-color: var(--glass-border); background: var(--glass-bg);"
            data-index={i}
            data-project-card
          >
            <div
              class="relative aspect-video w-full overflow-hidden"
              style="background: var(--navy-soft);"
            >
              <img
                src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
                data-project-image-src="/media/panda/panda-coding.png"
                alt={project.imageAlt}
                width="1600"
                height="2000"
                class="h-full w-full object-cover opacity-40"
                data-project-image
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                <span
                  class="font-display text-xs uppercase tracking-widest"
                  style="color: var(--paper); opacity: 0.4;"
                >
                  {project.title}
                </span>
              </div>
            </div>

            <div class="flex flex-1 flex-col gap-4 p-6">
              <h3
                class="font-display leading-tight"
                style="font-size: var(--text-xl); color: var(--paper);"
              >
                {project.title}
              </h3>

              <p
                class="font-body flex-1 leading-relaxed"
                style="font-size: var(--text-sm); color: color-mix(in srgb, var(--paper) 70%, transparent);"
              >
                {project.description}
              </p>

              <div class="flex flex-wrap gap-2" aria-label="Tech stack">
                {project.stack.map((tech) => (
                  <span
                    class="font-display rounded-sm px-2 py-0.5 text-xs"
                    style="background: var(--scarlet-dim); color: var(--scarlet-soft); border: 1px solid var(--scarlet-dim);"
                  >
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex gap-4">
                {project.liveUrl && project.liveUrl !== '#' && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-display text-xs uppercase tracking-widest transition-colors"
                    style="color: var(--scarlet);"
                    aria-label={`Live demo for ${project.title}`}
                  >
                    Live →
                  </a>
                )}
                {project.repoUrl && project.repoUrl !== '#' && (
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-display text-xs uppercase tracking-widest transition-colors"
                    style="color: var(--paper); opacity: 0.6;"
                    aria-label={`Source code for ${project.title}`}
                  >
                    Repo →
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
