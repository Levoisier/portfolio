---
/* FEATURED PROJECTS SECTION
   v3 experiment log: large editorial entries, formula-style stack chips,
   live links only. Confidential work belongs in ConfidentialProjects.
   Scroll choreography: see src/scripts/scroll/scenes/projects.ts.
*/

interface Project {
  number: string;
  title: string;
  description: string;
  stack: string[];
  liveUrl: string;
}

const projects: Project[] = [
  {
    number: '01',
    title: 'Le Parche',
    description:
      'Restaurant brand system and booking flow: cinematic Astro/GSAP frontage paired with Python-powered reservation operations.',
    stack: ['Astro', 'GSAP', 'React', 'TypeScript', 'Python'],
    liveUrl: 'https://leparche.com.co/',
  },
  {
    number: '02',
    title: 'Maison Cielare',
    description:
      'Shopify storefront and commerce setup for a sleepwear brand, with Liquid theme work, Mercado Pago, SellerChat, and a complete brand manual.',
    stack: ['Shopify', 'Liquid', 'HTML', 'CSS', 'Mercado Pago'],
    liveUrl: 'https://maisoncielare.com/',
  },
  {
    number: '03',
    title: 'Orquestia',
    description:
      'Agency landing page, portfolio, blog system, and brand manual built end-to-end with a focused Next.js and TypeScript stack.',
    stack: ['Next.js', 'React', 'TypeScript', 'Blog', 'Brand System'],
    liveUrl: 'https://www.orquestia.io/',
  },
];
---

<section id="projects" class="portfolio-section overflow-hidden section-pad" data-scene="projects">
  <img
    src="/media/panda/panda-coding.png"
    alt=""
    width="320"
    height="400"
    class="pointer-events-none absolute right-[max(1rem,6vw)] top-28 hidden w-[min(22vw,19rem)] select-none object-contain opacity-0 lg:block"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
    data-projects-builder
  />

  <div class="relative mx-auto max-w-6xl">
    <div class="mb-14 max-w-3xl">
      <p
        class="font-display mb-4 uppercase tracking-[0.28em]"
        style="font-size: var(--text-xs); color: var(--scarlet-soft);"
      >
        Experiment log
      </p>
      <h2
        class="font-display max-w-4xl uppercase leading-none"
        style="font-size: var(--text-4xl); color: var(--paper);"
      >
        Built work, measured in outcomes.
      </h2>
      <p
        class="font-body mt-6 max-w-2xl leading-relaxed"
        style="font-size: var(--text-lg); color: color-mix(in srgb, var(--paper) 76%, transparent);"
      >
        The panda-engineer starts with public launches: three production builds where interface,
        systems thinking, and brand craft had to react together.
      </p>
    </div>

    <div class="grid gap-0" data-projects-log>
      {
        projects.map((project) => (
          <article
            class="group grid gap-6 border-t py-10 md:grid-cols-[7rem_minmax(0,1fr)_auto] md:items-start md:gap-8 lg:py-14"
            style="border-color: var(--glass-border);"
            data-project-entry
          >
            <p
              class="font-display leading-none"
              style="font-size: var(--text-3xl); color: var(--scarlet);"
              aria-hidden="true"
              data-project-number
            >
              {project.number}
            </p>

            <div class="min-w-0">
              <h3
                class="font-display uppercase leading-none"
                style="font-size: var(--text-3xl); color: var(--paper);"
              >
                {project.title}
              </h3>

              <p
                class="font-body mt-5 max-w-3xl leading-relaxed"
                style="font-size: var(--text-base); color: color-mix(in srgb, var(--paper) 72%, transparent);"
              >
                {project.description}
              </p>

              <div
                class="mt-6 flex flex-wrap items-center gap-2"
                aria-label={`${project.title} technology formula`}
              >
                {project.stack.map((tech, index) => (
                  <>
                    <span
                      class="font-display inline-flex min-h-9 items-center border px-3 text-xs uppercase tracking-widest"
                      style="border-color: var(--scarlet-dim); background: var(--glass-bg); color: var(--scarlet-soft);"
                      data-project-chip
                    >
                      {tech}
                    </span>
                    {index < project.stack.length - 1 && (
                      <span
                        class="font-display text-xs"
                        style="color: color-mix(in srgb, var(--paper) 46%, transparent);"
                        aria-hidden="true"
                      >
                        +
                      </span>
                    )}
                  </>
                ))}
              </div>
            </div>

            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-display inline-flex min-h-11 items-center justify-self-start border-b text-xs uppercase tracking-[0.24em] transition-colors md:justify-self-end"
              style="border-color: var(--scarlet); color: var(--scarlet);"
              aria-label={`Open live site for ${project.title}`}
              data-project-link
            >
              Live →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
