---
/* HERO SECTION
   The panda + name reveal is the reference scene (see src/scripts/scroll/scenes/hero.ts).
   All elements start opacity:0; the scene drives the entrance animation.
   Structure:
     · #hero-panda        — centerpiece image (panda-hero.png + panda-head.png layers)
     · #hero-name         — "Cristian Zapata Cartagena" (chars split for stagger)
     · #hero-role         — role line
     · #hero-scroll-hint  — animated chevron
*/
---

<section
  id="hero"
  class="portfolio-section relative flex min-h-screen flex-col items-center justify-center overflow-hidden section-pad"
  data-scene="hero"
>
  <!-- Panda centerpiece -->
  <div
    id="hero-panda"
    class="relative z-10 mb-8 flex items-center justify-center"
    aria-hidden="true"
  >
    <picture>
      <source media="(max-width: 767px)" srcset="/media/panda/generated/panda-hero-320.webp" />
      <source media="(min-width: 768px)" srcset="/media/panda/generated/panda-hero-800.webp" />
      <img
        id="panda-body"
        src="/media/panda/panda-hero.png"
        alt=""
        width="400"
        height="500"
        class="aspect-[4/5] w-[60vw] max-w-[400px] select-none object-contain"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    </picture>
    <img
      id="panda-head"
      src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
      data-hero-head-src="/media/panda/panda-head.png"
      alt=""
      width="300"
      height="300"
      class="absolute aspect-square w-[45vw] max-w-[300px] select-none object-contain"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
      style="opacity: 0;"
    />
  </div>

  <!-- Name — characters are split by the hero scene for stagger animation -->
  <h1
    id="hero-name"
    class="font-display text-center leading-none tracking-tight"
    style="font-size: var(--text-hero); color: var(--paper);"
    aria-label="Cristian Zapata Cartagena"
  >
    Cristian Zapata Cartagena
  </h1>

  <!-- Role line -->
  <p
    id="hero-role"
    class="font-body mt-4 text-center uppercase tracking-widest"
    style="font-size: var(--text-lg); color: var(--scarlet); opacity: 0;"
  >
    Full Stack Developer &amp; Chemical Engineer
  </p>

  <!-- Scroll hint -->
  <div
    id="hero-scroll-hint"
    class="absolute bottom-8 left-1/2 -translate-x-1/2"
    style="opacity: 0;"
    aria-hidden="true"
  >
    <!-- Inline SVG chevron so no extra asset request -->
    <svg width="24" height="40" viewBox="0 0 24 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M12 4 L12 28 M4 20 L12 28 L20 20"
        stroke="var(--scarlet)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</section>
