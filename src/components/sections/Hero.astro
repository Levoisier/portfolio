---
/* HERO SECTION
   The panda + name reveal is the reference scene (see src/scripts/scroll/scenes/hero.ts).
   All elements start opacity:0; the scene drives the entrance animation.

   Layout (v4 Phase 26):
     · Mobile: centered vertical stack (panda over copy) — unchanged.
     · Desktop (lg+): editorial asymmetric split — panda anchored LEFT, the
       premise/name/role block RIGHT-aligned in the right column, on the
       liquid-glass surface, with deliberate negative space. Pure CSS layout
       (grid placement) — NOT a GSAP move — so the LCP panda paints immediately
       and its scroll-0 frame equals the static state.
   Structure:
     · #hero-veil         — presentation curtain over the backdrop stage; fades on scroll
     · #hero-panda        — centerpiece (panda-hero.png; LCP image remains untouched)
     · #hero-reaction-glow — non-LCP flask reaction layer (child of #hero-panda)
     · #hero-premise      — story opener
     · #hero-name         — "Cristian Zapata Cartagena" (chars split for stagger)
     · #hero-role         — role line
     · #hero-scroll-hint  — animated chevron
*/

import GlassSurface from '../ui/GlassSurface.astro';

/* Hero name, PRE-SPLIT AT BUILD TIME.
   The scene used to rewrite #hero-name on mount — clearing it and re-appending
   one <span> per character with <br> at the spaces. That reflowed the name from
   its natural wrap to three forced lines ~1.5s in (whenever the deferred
   controller mounted), which was the site's ENTIRE CLS: a single 0.076 shift on
   the hero copy block. Emitting the final structure here makes the pre-JS and
   post-JS layouts byte-identical, so the stagger animates spans that were
   always there. hero.ts now reads these instead of building them.

   Built as a string (not JSX) so no template whitespace can slip between the
   character spans and open gaps inside the words. */
const HERO_NAME = 'Cristian Zapata Cartagena';

const heroNameHtml = HERO_NAME.split(' ')
  .map((word) =>
    [...word].map((char) => `<span class="hero-char" aria-hidden="true">${char}</span>`).join('')
  )
  .join('<br aria-hidden="true" />');
---

<section
  id="hero"
  class="portfolio-section relative flex min-h-screen flex-col items-center justify-center overflow-hidden section-pad"
  data-scene="hero"
>
  <!-- Presentation veil — covers the parallax stage for the first view; the
       hero scene fades it out on scroll (see #hero-veil in global.css). -->
  <div id="hero-veil" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-center justify-center gap-3 sm:gap-6 lg:grid lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-16"
  >
    <!-- Panda centerpiece — left column on desktop -->
    <div
      id="hero-panda"
      class="relative z-10 flex items-center justify-center lg:justify-start"
      aria-hidden="true"
    >
      <picture>
        <source media="(max-width: 767px)" srcset="/media/panda/generated/panda-hero-320.webp" />
        <source media="(min-width: 768px)" srcset="/media/panda/generated/panda-hero-800.webp" />
        <img
          id="panda-body"
          src="/media/panda/panda-hero.png"
          alt=""
          width="400"
          height="500"
          class="aspect-[4/5] w-[72vw] max-w-[400px] select-none object-contain"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </picture>
      <div
        id="hero-reaction-glow"
        class="pointer-events-none absolute left-[54%] top-[44%] h-[18%] w-[24%] -translate-x-1/2 -translate-y-1/2 rounded-full"
        style="
          opacity: 0;
          background: radial-gradient(circle, var(--scarlet-soft), var(--scarlet-dim) 48%, transparent 72%);
          filter: blur(18px);
          mix-blend-mode: screen;
          will-change: opacity, transform;
        "
      >
      </div>
    </div>

    <!-- Copy block — right column on desktop, right-aligned over the glass -->
    <div class="flex w-full flex-col items-center lg:items-end">
      <GlassSurface
        class="w-full px-6 py-7 text-center lg:w-auto lg:max-w-xl lg:px-9 lg:py-9 lg:text-right"
      >
        <p
          id="hero-premise"
          class="font-display mb-4 uppercase tracking-[0.18em] sm:tracking-[0.24em]"
          style="font-size: var(--text-sm); color: var(--paper);"
          data-i18n="hero.premise"
        >
          Conoce un poco de mi trabajo
        </p>

        <!-- Name — one word per line (avoids any truncation); characters are
             pre-split into spans at build time for the stagger animation.
             See heroNameHtml above: this markup is final, JS never rebuilds it. -->
        <h1
          id="hero-name"
          class="font-display leading-[0.96] tracking-normal"
          style="color: var(--paper);"
          aria-label={HERO_NAME}
          set:html={heroNameHtml}
        />

        <!-- Role line — always two lines, each translated independently. -->
        <p
          id="hero-role"
          class="font-body mt-4 uppercase tracking-widest"
          style="font-size: var(--text-lg); color: var(--scarlet);"
        >
          <span class="block" data-i18n="hero.role.line1">Full Stack Developer &amp;</span>
          <span class="block" data-i18n="hero.role.line2">Ingeniero Químico</span>
        </p>
      </GlassSurface>
    </div>
  </div>

  <!-- Scroll hint — faded in, then bobbed, by heroEntrance.ts (which also parks
       the bob once the hero leaves the viewport). -->
  <div id="hero-scroll-hint" class="absolute bottom-8 left-1/2 -translate-x-1/2" aria-hidden="true">
    <!-- Inline SVG chevron so no extra asset request -->
    <svg width="24" height="40" viewBox="0 0 24 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M12 4 L12 28 M4 20 L12 28 L20 20"
        stroke="var(--scarlet)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</section>
