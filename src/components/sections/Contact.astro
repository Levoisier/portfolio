---
/* CONTACT SECTION / FOOTER
   Minimal close: title + the line below it, then links — no kicker above the
   title, no trademark/copyright line below the links. Background is a
   lava-lamp glow: several blurred color blobs rising from the bottom of the
   footer, diffused behind a frosted "crystal glass" pane so text stays
   readable. Closes with a panda party: all five companion poses
   jumping/wiggling/fading together as the site's sign-off.
   Animation: src/scripts/scroll/scenes/contact.ts (entrance) + the CSS
   @keyframes below (idle loops — auto-disabled under reduced motion by the
   sitewide kill-switch in global.css, same as the liquid-glass sheen drift).
*/

const pandaParty = [
  { pose: 'wave', src: '/media/panda/panda-wave.png', width: 160, height: 200 },
  { pose: 'hero', src: '/media/panda/panda-hero.png', width: 160, height: 200 },
  { pose: 'coding', src: '/media/panda/panda-coding.png', width: 160, height: 200 },
  { pose: 'master', src: '/media/panda/panda-master.png', width: 160, height: 160 },
  { pose: 'head', src: '/media/panda/panda-head.png', width: 160, height: 160 },
];
---

<section
  id="contact"
  class="portfolio-section relative section-pad overflow-hidden"
  data-scene="contact"
  style="background-color: var(--paper);"
>
  <!-- Lava-lamp glow — several blurred blobs rising from the bottom of the
       footer, diffused behind a frosted crystal-glass pane. Pure CSS/code-drawn
       (no image asset); auto-settles to a static resting glow under reduced
       motion via the sitewide kill-switch. -->
  <div class="lava-blobs" data-contact-glow aria-hidden="true">
    <span class="lava-blob lava-blob--a"></span>
    <span class="lava-blob lava-blob--b"></span>
    <span class="lava-blob lava-blob--c"></span>
    <span class="lava-blob lava-blob--d"></span>
    <span class="lava-blob lava-blob--e"></span>
    <span class="lava-blob lava-blob--f"></span>
    <span class="lava-blob lava-blob--g"></span>
  </div>
  <div class="contact-glass" aria-hidden="true"></div>

  <div
    class="contact-panel relative z-10 mx-auto flex max-w-3xl flex-col items-center px-6 py-10 text-center md:px-12 md:py-14"
  >
    <h2
      class="font-display mb-8 leading-tight tracking-normal"
      data-contact-heading
      style="font-size: clamp(2rem, 12vw, 3rem); color: var(--navy);"
      data-i18n="contact.heading"
    >
      Hablemos
    </h2>

    <p
      class="font-body mx-auto mb-10 max-w-2xl leading-relaxed"
      style="font-size: var(--text-base); color: color-mix(in srgb, var(--navy) 82%, transparent);"
      data-i18n="contact.body"
    >
      Trae un problema y te ayudo a convertirlo en la próxima oportunidad de crecimiento.
    </p>

    <!-- Contact links -->
    <nav aria-label="Contact links">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-5 md:gap-x-12">
        <li data-contact-link>
          <a
            href="mailto:ing.cristian.cartagena@gmail.com"
            class="contact-link group flex items-center gap-3"
            style="color: var(--navy);"
            aria-label="Enviar email a Cristian"
            data-i18n-aria="contact.email-aria"
          >
            <!-- Email icon -->
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              class="contact-link__icon"
              style="color: var(--scarlet);"
            >
              <rect
                x="2"
                y="5"
                width="16"
                height="12"
                rx="1.5"
                stroke="currentColor"
                stroke-width="1.5"></rect>
              <path d="M2 7l8 5 8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              ></path>
            </svg>
            <span class="contact-link__label">ing.cristian.cartagena@gmail.com</span>
          </a>
        </li>

        <li data-contact-link>
          <a
            href="https://github.com/levoisier"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-link group flex items-center gap-3"
            style="color: var(--navy);"
            aria-label="Perfil de GitHub (abre en nueva pestaña)"
            data-i18n-aria="contact.github-aria"
          >
            <!-- GitHub icon -->
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              class="contact-link__icon"
              style="color: var(--scarlet);"
            >
              <path
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
            <span class="contact-link__label">github.com/levoisier</span>
          </a>
        </li>

        <li data-contact-link>
          <a
            href="https://wa.me/573015093825"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-link group flex items-center gap-3"
            style="color: var(--navy);"
            aria-label="Escribirle a Cristian por WhatsApp (abre en nueva pestaña)"
            data-i18n-aria="contact.whatsapp-aria"
          >
            <!-- WhatsApp icon -->
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              class="contact-link__icon"
              style="color: var(--scarlet);"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
            <span class="contact-link__label">+57 301 509 3825</span>
          </a>
        </li>

        <li data-contact-link>
          <a
            href="https://linkedin.com/in/levoisier"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-link group flex items-center gap-3"
            style="color: var(--navy);"
            aria-label="Perfil de LinkedIn (abre en nueva pestaña)"
            data-i18n-aria="contact.linkedin-aria"
          >
            <!-- LinkedIn icon -->
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              class="contact-link__icon"
              style="color: var(--scarlet);"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
            <span class="contact-link__label">linkedin.com/in/levoisier</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Panda party — the whole crew, jumping/wiggling/fading in an easter-egg
       sign-off. Decorative: images carry alt="" and the row is aria-hidden. -->
  <div class="panda-party" data-panda-party aria-hidden="true">
    {
      pandaParty.map((panda) => (
        <div class="panda-party__item" data-panda-party-item data-panda-pose={panda.pose}>
          <img
            src={panda.src}
            alt=""
            width={panda.width}
            height={panda.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Lava-lamp glow — blurred radial blobs, each pulsing up from its resting
     spot near the bottom and sinking back (0%/100% share a state, so the
     loop is seamless and the reduced-motion single-frame lands on a calm,
     static glow instead of a jump cut). */
  .lava-blobs {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .lava-blob {
    position: absolute;
    bottom: -12%;
    border-radius: 50%;
    filter: blur(1.6rem);
    animation: lava-rise 18s ease-in-out infinite;
    will-change: transform, opacity;
  }

  .lava-blob--a {
    left: 4%;
    width: clamp(6rem, 18vw, 11rem);
    height: clamp(6rem, 18vw, 11rem);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--scarlet) 92%, transparent) 0%,
      transparent 70%
    );
    animation-duration: 16s;
    animation-delay: -2s;
    --drift: 5%;
  }

  .lava-blob--b {
    left: 18%;
    width: clamp(4rem, 12vw, 7rem);
    height: clamp(4rem, 12vw, 7rem);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--navy) 92%, transparent) 0%,
      transparent 70%
    );
    animation-duration: 21s;
    animation-delay: -9s;
    --drift: -6%;
  }

  .lava-blob--c {
    left: 34%;
    width: clamp(7rem, 20vw, 13rem);
    height: clamp(7rem, 20vw, 13rem);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--scarlet-soft) 88%, transparent) 0%,
      transparent 70%
    );
    animation-duration: 24s;
    animation-delay: -14s;
    --drift: 4%;
  }

  .lava-blob--d {
    left: 50%;
    width: clamp(5rem, 15vw, 9rem);
    height: clamp(5rem, 15vw, 9rem);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--navy-soft) 90%, transparent) 0%,
      transparent 70%
    );
    animation-duration: 17s;
    animation-delay: -5s;
    --drift: -5%;
  }

  .lava-blob--e {
    left: 64%;
    width: clamp(6rem, 17vw, 10rem);
    height: clamp(6rem, 17vw, 10rem);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--scarlet) 85%, transparent) 0%,
      transparent 70%
    );
    animation-duration: 22s;
    animation-delay: -11s;
    --drift: 6%;
  }

  .lava-blob--f {
    left: 80%;
    width: clamp(4.5rem, 13vw, 8rem);
    height: clamp(4.5rem, 13vw, 8rem);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--navy) 88%, transparent) 0%,
      transparent 70%
    );
    animation-duration: 19s;
    animation-delay: -7s;
    --drift: -4%;
  }

  .lava-blob--g {
    left: 92%;
    width: clamp(5rem, 14vw, 9rem);
    height: clamp(5rem, 14vw, 9rem);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--scarlet-soft) 85%, transparent) 0%,
      transparent 70%
    );
    animation-duration: 25s;
    animation-delay: -18s;
    --drift: 5%;
  }

  @keyframes lava-rise {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.62;
    }
    50% {
      transform: translate3d(var(--drift, 4%), -68%, 0) scale(1.08);
      opacity: 1;
    }
  }

  /* Fewer, lighter-blurred blobs on touch — protects mobile paint budget,
     same reasoning as --glass-blur-mobile elsewhere in the design system. */
  @media (max-width: 767px) {
    .lava-blob {
      filter: blur(1.4rem);
    }

    .lava-blob--f,
    .lava-blob--g {
      display: none;
    }
  }

  /* Crystal-glass pane — diffuses the blobs into a soft glow without erasing
     their color. Opaque-ish paper fallback first; browsers with
     backdrop-filter support get the true frosted-glass read (that blur pass
     is what keeps the ambient blobs soft, not this layer's own opacity —
     see .contact-panel below for where actual text-contrast guarantees
     live). */
  .contact-glass {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .contact-glass {
      background: color-mix(in srgb, var(--paper) 34%, transparent);
      backdrop-filter: blur(var(--glass-blur));
      -webkit-backdrop-filter: blur(var(--glass-blur));
    }

    @media (max-width: 767px) {
      .contact-glass {
        backdrop-filter: blur(var(--glass-blur-mobile));
        -webkit-backdrop-filter: blur(var(--glass-blur-mobile));
      }
    }
  }

  /* Text card — sits above the ambient glow and guarantees contrast for the
     title/body/links regardless of which blob color happens to drift behind
     it. This is the "crystal glass" read up close: near-opaque paper with a
     soft rim, like a frosted pane laid over the lamp. */
  .contact-panel {
    border-radius: var(--glass-radius);
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    border: 1px solid color-mix(in srgb, var(--navy) 10%, transparent);
    box-shadow: 0 1.5rem 3rem color-mix(in srgb, var(--navy) 12%, transparent);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .contact-panel {
      background: color-mix(in srgb, var(--paper) 82%, transparent);
      backdrop-filter: blur(calc(var(--glass-blur) * 0.55));
      -webkit-backdrop-filter: blur(calc(var(--glass-blur) * 0.55));
    }
  }

  .contact-link {
    color: var(--navy);
    text-decoration: none;
    transition: color 0.2s var(--ease-out-expo);
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--scarlet);
  }

  .contact-link__icon {
    transition: color 0.2s var(--ease-out-expo);
  }

  .contact-link__label {
    font-size: var(--text-sm);
  }

  .contact-link:focus-visible {
    outline: 2px solid var(--scarlet);
    outline-offset: 4px;
  }

  /* Panda party row — flex-wrap + vw-clamped item widths so five pandas
     always reflow instead of forcing horizontal scroll on narrow phones. */
  .panda-party {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(0.5rem, 3vw, 1.75rem);
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    max-width: 42rem;
    padding: 0 1rem;
  }

  .panda-party__item {
    flex: 0 0 auto;
    width: clamp(3.4rem, 12vw, 6rem);
    max-width: 100%;
  }

  .panda-party__item img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 8px 10px color-mix(in srgb, var(--navy) 22%, transparent));
    transform-origin: 50% 100%;
    animation: panda-party-idle 2.6s ease-in-out infinite;
  }

  /* Stagger each pose's timing so the row feels alive/asynchronous rather
     than a single synchronized bounce — the "party" read. */
  .panda-party__item:nth-child(1) img {
    animation-duration: 2.4s;
    animation-delay: 0s;
  }
  .panda-party__item:nth-child(2) img {
    animation-duration: 3s;
    animation-delay: 0.35s;
  }
  .panda-party__item:nth-child(3) img {
    animation-duration: 2.2s;
    animation-delay: 0.7s;
  }
  .panda-party__item:nth-child(4) img {
    animation-duration: 3.2s;
    animation-delay: 0.15s;
  }
  .panda-party__item:nth-child(5) img {
    animation-duration: 2.7s;
    animation-delay: 0.5s;
  }

  @keyframes panda-party-idle {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
    }
    22% {
      transform: translateY(-16%) rotate(-6deg);
      opacity: 0.85;
    }
    48% {
      transform: translateY(2%) rotate(4deg);
      opacity: 1;
    }
    72% {
      transform: translateY(-9%) rotate(-3deg);
      opacity: 0.92;
    }
  }

  /* Parent-level hover/tap boost — separate element from the one running the
     keyframe, so it composes with the idle bob instead of fighting it. */
  .panda-party__item {
    transition: transform 0.25s var(--ease-spring);
  }

  .panda-party__item:hover,
  .panda-party__item:active {
    transform: scale(1.16) translateY(-8%);
  }
</style>
